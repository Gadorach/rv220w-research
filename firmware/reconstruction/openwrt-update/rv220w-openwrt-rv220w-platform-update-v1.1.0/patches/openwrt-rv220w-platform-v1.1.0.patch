diff --git a/target/linux/octeon/patches-6.12/410-cisco-rv220w-dts.patch b/target/linux/octeon/patches-6.12/410-cisco-rv220w-dts.patch
new file mode 100644
index 0000000..6584f57
--- /dev/null
+++ b/target/linux/octeon/patches-6.12/410-cisco-rv220w-dts.patch
@@ -0,0 +1,120 @@
+--- a/arch/mips/boot/dts/cavium-octeon/Makefile
++++ b/arch/mips/boot/dts/cavium-octeon/Makefile
+@@ -2 +2,2 @@
+-dtb-$(CONFIG_CAVIUM_OCTEON_SOC)	+= octeon_3xxx.dtb octeon_68xx.dtb
++dtb-$(CONFIG_CAVIUM_OCTEON_SOC)	+= octeon_3xxx.dtb octeon_68xx.dtb \
++	cn5010_cisco_rv220w.dtb
+--- /dev/null
++++ b/arch/mips/boot/dts/cavium-octeon/cn5010_cisco_rv220w.dts
+@@ -0,0 +1,111 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * Cisco RV220W conservative RAM-validation device tree.
++ *
++ * Proven facts are enabled.  The BCM53115 management node and the active-low
++ * reset/recovery button are represented but disabled until Linux-side control
++ * is tested.  U-Boot's working switch configuration is intentionally retained.
++ */
++
++/include/ "octeon_3xxx.dtsi"
++
++/ {
++	model = "Cisco RV220W";
++	compatible = "cisco,rv220w", "cavium,octeon-3860";
++
++	aliases {
++		serial0 = &uart0;
++		pip = &pip;
++		smi0 = &smi0;
++		twsi0 = &twsi0;
++		ethernet0 = &rgmii0;
++		ethernet1 = &rgmii1;
++		ethernet2 = &rgmii2;
++	};
++
++	chosen {
++		stdout-path = "serial0:115200n8";
++	};
++
++	/* U-Boot configures and samples GPIO 1, entering recovery when low. */
++	rv220w-reset-keys {
++		compatible = "gpio-keys";
++		status = "disabled";
++
++		reset {
++			label = "reset/recovery";
++			linux,code = <0x198>; /* KEY_RESTART */
++			gpios = <&gpio 1 1>; /* GPIO_ACTIVE_LOW */
++			debounce-interval = <60>;
++		};
++	};
++};
++
++&uart0 {
++	status = "okay";
++};
++
++&twsi0 {
++	status = "okay";
++};
++
++&smi0 {
++	status = "okay";
++
++	/*
++	 * Confirmed by U-Boot and stock bcm5398/mii modules:
++	 * Broadcom pseudo-PHY management address 0x1e.  Keep disabled until the
++	 * exact CPU/IMP and WAN/LAN internal port map is proven for B53/DSA.
++	 */
++	switch@1e {
++		compatible = "brcm,bcm53115";
++		reg = <0x1e>;
++		status = "disabled";
++	};
++};
++
++&pip {
++	status = "okay";
++
++	interface@0 {
++		status = "okay";
++
++		rgmii0: ethernet@0 {
++			status = "okay";
++			rx-delay = <0>;
++			tx-delay = <0>;
++			fixed-link {
++				speed = <1000>;
++				full-duplex;
++			};
++		};
++
++		rgmii1: ethernet@1 {
++			status = "okay";
++			rx-delay = <0>;
++			tx-delay = <0>;
++			fixed-link {
++				speed = <1000>;
++				full-duplex;
++			};
++		};
++
++		rgmii2: ethernet@2 {
++			status = "okay";
++		};
++	};
++};
++
++/* The generic USB node hangs this board in octeon_usb_probe(). */
++&usbn {
++	status = "disabled";
++};
++
++/*
++ * Keep the DT BootBus node disabled for the first board-specific boot.  The
++ * proven legacy Octeon phys_mapped_flash path preserves U-Boot timing and reads
++ * the 32 MiB x16 NOR correctly.  All command-line partitions are read-only.
++ */
++&bootbus {
++	status = "disabled";
++};
