#!/bin/sh
# RV220W RAM-only squashfs live-root launcher.
# The embedded squashfs is copied into tmpfs, mounted read-only, and given a
# tmpfs overlay. Nothing is read from or written to the router NOR.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

echo '[rv220w-live] starting embedded SquashFS validation root'
mkdir -p /dev /proc /sys /run /tmp /lower /newroot
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t tmpfs -o mode=0755,size=56m tmpfs /run || {
    echo '[rv220w-live] unable to mount tmpfs at /run'
    exec sh
}

modprobe loop 2>/dev/null || true
modprobe squashfs 2>/dev/null || true
modprobe overlay 2>/dev/null || true

mkdir -p /run/rv220w/upper /run/rv220w/work
if ! cp /rv220w/rootfs.squashfs /run/rv220w/rootfs.squashfs; then
    echo '[rv220w-live] unable to stage embedded rootfs in tmpfs'
    exec sh
fi
if ! mount -t squashfs -o loop,ro /run/rv220w/rootfs.squashfs /lower; then
    echo '[rv220w-live] SquashFS mount failed; dropping to rescue shell'
    exec sh
fi
if ! mount -t overlay overlay \
    -o lowerdir=/lower,upperdir=/run/rv220w/upper,workdir=/run/rv220w/work \
    /newroot; then
    echo '[rv220w-live] overlay mount failed; dropping to rescue shell'
    exec sh
fi

# Preserve every mount referenced by the overlay across switch_root.  /rom is
# the conventional OpenWrt name for the read-only SquashFS lower filesystem.
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run /newroot/rom
mount --move /lower /newroot/rom
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run

echo '[rv220w-live] switching to SquashFS + tmpfs overlay root'
exec switch_root /newroot /sbin/init
