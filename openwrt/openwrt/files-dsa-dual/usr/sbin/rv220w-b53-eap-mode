#!/bin/sh
# RV220W BCM53115 standalone-port EAP mode controller.
#
# RAM-only safety model:
#   - read operations use pseudo-PHY selectors 0x1e:0x10/0x11 and data reads.
#   - set/restore writes are restricted to one 64-bit EAP configuration entry
#     on page 0x42 for external user ports 0..4.
#   - only EAP mode bits 52:51 are changed; all other bits are preserved.
#   - CPU ports, PHY control, reset, VLAN/ARL/MIB control and flash are refused.
set -u

action=${1:-show}
port=${2:-0}
bus=${3:-8001180000001800}

case "$action" in
    show|show-all|set-basic|set-simplified|restore) ;;
    *)
        echo "usage: $0 {show|show-all|set-basic|set-simplified|restore} [port] [mdio-bus]" >&2
        exit 2
        ;;
esac
case "$port" in
    ''|*[!0-9]*) echo "ERROR: port must be numeric" >&2; exit 2 ;;
esac
[ "$port" -ge 0 ] && [ "$port" -le 8 ] || {
    echo "ERROR: port must be 0..8" >&2
    exit 2
}
case "$bus" in
    *[!A-Za-z0-9._:-]*|'') echo "ERROR: unsafe MDIO bus selector" >&2; exit 2 ;;
esac

pseudo_phy=30
reg_page=16
reg_addr=17
reg_data0=24
reg_data1=25
reg_data2=26
reg_data3=27
eap_page=66
state_dir=${RV220W_EAP_STATE_DIR:-/tmp}
selector_saved=0
initial_page=
initial_addr=

c22_read() {
    mdio "$bus" phy "$pseudo_phy" raw "$1" 2>/dev/null | tail -n 1
}

c22_write() {
    case "$1" in
        16|17|24|25|26|27) ;;
        *) echo "ERROR: refused MDIO write reg=$1" >&2; return 90 ;;
    esac
    mdio "$bus" phy "$pseudo_phy" raw "$1" "$2" >/dev/null 2>&1
}

restore_selectors() {
    [ "$selector_saved" -eq 1 ] || return 0
    [ -n "$initial_page" ] && c22_write "$reg_page" "$initial_page" >/dev/null 2>&1 || true
    if [ -n "$initial_addr" ]; then
        initial_addr_num=$((initial_addr))
        if [ $((initial_addr_num & 3)) -eq 0 ]; then
            c22_write "$reg_addr" "$initial_addr" >/dev/null 2>&1 || true
        fi
    fi
}
trap 'restore_selectors' EXIT HUP INT TERM

wait_complete() {
    tries=0
    while [ "$tries" -lt 40 ]; do
        status=$(c22_read "$reg_addr") || return 1
        case "$status" in
            0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
            *) return 1 ;;
        esac
        status_num=$((status))
        [ $((status_num & 3)) -eq 0 ] && return 0
        tries=$((tries + 1))
        usleep 100 2>/dev/null || sleep 0.01
    done
    return 1
}

select_read() {
    page=$1 reg=$2
    c22_write "$reg_page" "$(printf '0x%04x' $(((page & 255) << 8 | 1)))" || return 1
    c22_write "$reg_addr" "$(printf '0x%04x' $(((reg & 255) << 8 | 2)))" || return 1
    wait_complete
}

read_eap_words() {
    p=$1
    reg=$((32 + 8 * p))
    select_read "$eap_page" "$reg" || return 1
    eap_d0=$(c22_read "$reg_data0") || return 1
    eap_d1=$(c22_read "$reg_data1") || return 1
    eap_d2=$(c22_read "$reg_data2") || return 1
    eap_d3=$(c22_read "$reg_data3") || return 1
    case "$eap_d0:$eap_d1:$eap_d2:$eap_d3" in
        0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
        *) return 1 ;;
    esac
}

mode_name() {
    case "$1" in
        0) echo basic ;;
        3) echo simplified ;;
        1) echo reserved-1 ;;
        2) echo reserved-2 ;;
        *) echo invalid ;;
    esac
}

print_words() {
    p=$1 prefix=${2:-eap}
    d0=$((eap_d0)); d1=$((eap_d1)); d2=$((eap_d2)); d3=$((eap_d3))
    mode=$(((d3 >> 3) & 3))
    printf 'port=%d\n' "$p"
    printf '%s_raw=0x%04x%04x%04x%04x\n' "$prefix" "$d3" "$d2" "$d1" "$d0"
    printf '%s_words=0x%04x,0x%04x,0x%04x,0x%04x\n' "$prefix" "$d0" "$d1" "$d2" "$d3"
    printf '%s_mode_code=%d\n' "$prefix" "$mode"
    printf '%s_mode=%s\n' "$prefix" "$(mode_name "$mode")"
}

write_eap_words() {
    p=$1 d0=$2 d1=$3 d2=$4 d3=$5
    reg=$((32 + 8 * p))
    c22_write "$reg_page" "$(printf '0x%04x' $(((eap_page & 255) << 8 | 1)))" || return 1
    c22_write "$reg_data0" "$(printf '0x%04x' $((d0 & 65535)))" || return 1
    c22_write "$reg_data1" "$(printf '0x%04x' $((d1 & 65535)))" || return 1
    c22_write "$reg_data2" "$(printf '0x%04x' $((d2 & 65535)))" || return 1
    c22_write "$reg_data3" "$(printf '0x%04x' $((d3 & 65535)))" || return 1
    c22_write "$reg_addr" "$(printf '0x%04x' $(((reg & 255) << 8 | 1)))" || return 1
    wait_complete
}

command -v mdio >/dev/null 2>&1 || {
    echo "ERROR: mdio utility not found" >&2
    exit 1
}
initial_page=$(c22_read "$reg_page") || initial_page=
initial_addr=$(c22_read "$reg_addr") || initial_addr=
case "$initial_page:$initial_addr" in
    0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) selector_saved=1 ;;
    *) echo "ERROR: pseudo-PHY selectors are not readable" >&2; exit 1 ;;
esac

if [ "$action" = show-all ]; then
    for port in 0 1 2 3 4 5 8; do
        echo "[port $port]"
        if read_eap_words "$port"; then
            print_words "$port"
        else
            echo "ERROR: EAP read failed"
        fi
    done
    exit 0
fi

read_eap_words "$port" || {
    echo "ERROR: could not read EAP configuration for port $port" >&2
    exit 1
}
echo 'RV220W BCM53115 EAP mode control'
echo "action=$action"
echo "bus=$bus"
echo 'policy=RAM-only; writes restricted to EAP mode bits 52:51 for external user ports 0..4; no flash writes'
print_words "$port" before

[ "$action" = show ] && exit 0

[ "$port" -le 4 ] || {
    echo "ERROR: write actions are restricted to external user ports 0..4; CPU/unused port write refused" >&2
    exit 90
}

save=$state_dir/rv220w-b53-eap-port${port}.original
if [ "$action" = restore ]; then
    [ -r "$save" ] || {
        echo "ERROR: no saved original state at $save" >&2
        exit 1
    }
    read sd0 sd1 sd2 sd3 < "$save" || {
        echo "ERROR: saved state is unreadable" >&2
        exit 1
    }
    case "$sd0:$sd1:$sd2:$sd3" in
        0x[0-9a-fA-F]*:0x[0-9a-fA-F]*:0x[0-9a-fA-F]*:0x[0-9a-fA-F]*) ;;
        *) echo "ERROR: saved state is malformed" >&2; exit 1 ;;
    esac
    write_eap_words "$port" "$((sd0))" "$((sd1))" "$((sd2))" "$((sd3))" || {
        echo "ERROR: EAP restore write failed" >&2
        exit 1
    }
else
    if [ ! -e "$save" ]; then
        umask 077
        printf '0x%04x 0x%04x 0x%04x 0x%04x\n' "$((eap_d0))" "$((eap_d1))" "$((eap_d2))" "$((eap_d3))" > "$save" || exit 1
    fi
    d0=$((eap_d0)); d1=$((eap_d1)); d2=$((eap_d2)); d3=$((eap_d3))
    d3=$((d3 & ~0x18))
    case "$action" in
        set-basic) mode=0 ;;
        set-simplified) mode=3; d3=$((d3 | 0x18)) ;;
    esac
    write_eap_words "$port" "$d0" "$d1" "$d2" "$d3" || {
        echo "ERROR: EAP mode write failed" >&2
        exit 1
    }
fi

read_eap_words "$port" || {
    echo "ERROR: EAP readback failed" >&2
    exit 1
}
print_words "$port" after
case "$action" in
    set-basic) expected=0 ;;
    set-simplified) expected=3 ;;
    restore) expected=restore ;;
esac
actual=$((($((eap_d3)) >> 3) & 3))
if [ "$expected" != restore ] && [ "$actual" -ne "$expected" ]; then
    echo "ERROR: EAP mode readback mismatch expected=$expected actual=$actual" >&2
    exit 1
fi
echo "saved_original=$save"
echo 'result=ok'
