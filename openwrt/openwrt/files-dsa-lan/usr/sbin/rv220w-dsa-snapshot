#!/bin/sh
set -u
label=${1:-snapshot}
label=$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_')
stamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || printf unknown)
out="/tmp/rv220w-dsa-${label}-${stamp}.txt"

profile=lan-only
[ -e /sys/class/net/wan ] && profile=dual-conduit

exec 3>&1
{
	echo 'RV220W DSA validation snapshot'
	echo "profile=$profile"
	echo "label=$label"
	echo "time=$stamp"
	echo 'policy=RAM-only DSA ownership test; B53/DSA switch reset/reconfiguration allowed; no automated flash writes'
	uname -a
	cat /etc/rv220w-build 2>/dev/null || true

	echo
	echo '=== KERNEL_DSA ==='
	dmesg | grep -Ei 'b53|dsa|brcm|mdio|eth[0-9]|wan|lan[1-4]|br-lan|affinity|fixed.link|phylink|rgmii|switch' | tail -n 300 || true
	lsmod | grep -E '(^| )(b53|dsa|tag_brcm|mdio)' || true
	echo '--- tag-driver availability ---'
	find /lib/modules/$(uname -r) -maxdepth 1 -type f \( -name 'tag_brcm.ko' -o -name 'tag_none.ko' \) -print 2>/dev/null | sort || true
	for module_list in /etc/modules.d/*; do
		[ -f "$module_list" ] || continue
		grep -qE '(^|[[:space:]])(tag_brcm|b53_common|b53_mdio)($|[[:space:]])' "$module_list" 2>/dev/null || continue
		echo "[$module_list]"
		cat "$module_list"
	done

	echo
	echo '=== INTERFACES ==='
	ip -details -statistics link show 2>&1 || true
	ip address show 2>&1 || true
	ip route show table all 2>&1 || true

	echo
	echo '=== DSA_SYSFS ==='
	for dev in eth0 eth1 eth2 wan lan1 lan2 lan3 lan4 br-lan; do
		[ -e "/sys/class/net/$dev" ] || continue
		echo "[$dev]"
		for item in ifindex address carrier operstate mtu; do
			printf '%s=' "$item"
			cat "/sys/class/net/$dev/$item" 2>/dev/null || echo unavailable
		done
		printf 'netdev_of_node='; readlink -f "/sys/class/net/$dev/of_node" 2>/dev/null || echo none
		printf 'parent_of_node='; readlink -f "/sys/class/net/$dev/device/of_node" 2>/dev/null || echo none
		printf 'master='; readlink -f "/sys/class/net/$dev/master" 2>/dev/null || echo none
		printf 'lower='; find "/sys/class/net/$dev" -maxdepth 1 -type l -name 'lower_*' -printf '%f ' 2>/dev/null; echo
		printf 'upper='; find "/sys/class/net/$dev" -maxdepth 1 -type l -name 'upper_*' -printf '%f ' 2>/dev/null; echo
		find "/sys/class/net/$dev" -maxdepth 2 -type f \( -name dsa_tag_protocol -o -name phys_port_name -o -name phys_switch_id \) -print -exec cat {} \; 2>/dev/null || true
	done

	echo
	echo '=== DSA_AFFINITY ==='
	if [ -x /usr/sbin/rv220w-dsa-affinity ]; then
		/usr/sbin/rv220w-dsa-affinity --check 2>&1 && echo affinity_check=ok || echo affinity_check=failed
		cat /tmp/rv220w-dsa-affinity.status 2>/dev/null || true
	else
		echo affinity_check=not-applicable
	fi
	for dev in wan lan1 lan2 lan3 lan4; do
		[ -e "/sys/class/net/$dev" ] || continue
		echo "--- $dev ---"
		ip -d link show dev "$dev" 2>&1 || true
	done

	echo
	echo '=== BRIDGE ==='
	bridge -details link show 2>&1 || true
	bridge fdb show 2>&1 || true
	bridge vlan show 2>&1 || true

	echo
	echo '=== ETHTOOL ==='
	for dev in eth0 eth1 wan lan1 lan2 lan3 lan4; do
		[ -e "/sys/class/net/$dev" ] || continue
		echo "--- $dev ---"
		ethtool "$dev" 2>&1 || true
		ethtool -i "$dev" 2>&1 || true
		ethtool -S "$dev" 2>&1 || true
	done

	echo
	echo '=== MDIO_AND_DT ==='
	find /sys/bus/mdio_bus/devices -maxdepth 2 -type l -o -type d 2>/dev/null | sort || true
	for node in /proc/device-tree/soc/smi@*/switch@1e /proc/device-tree/soc/pip@*/interface@0/ethernet@0 /proc/device-tree/soc/pip@*/interface@0/ethernet@1; do
		[ -e "$node" ] || continue
		echo "node=$node"
		find "$node" -maxdepth 3 -type f -printf '%p\n' 2>/dev/null | sort || true
	done

	echo
	echo '=== UCI ==='
	uci show network 2>&1 || true
	ubus call network.interface.lan status 2>&1 || true
	ubus call network.interface.wan status 2>&1 || true

	echo
	echo '=== END ==='
	echo "output=$out"
} >"$out" 2>&1
printf '%s\n' "$out" >&3
printf 'RV220W DSA snapshot: %s\n' "$out" >/dev/console
