/*
 * Cisco RV220W RAM-only LAN DSA ownership-validation device tree.
 *
 * Hardware evidence maps BCM53115 ports 1-4 to LAN1-LAN4 and port 8 to
 * Octeon eth0.  WAN port 0 and its port-5/eth1 conduit are intentionally
 * absent from this first ownership test.  The B53 driver will reset and
 * reconfigure the switch; all changes vanish on power cycle.
 */

/include/ "octeon_3xxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Cisco RV220W LAN-only DSA validation (@VARIANT@)";
	compatible = "cisco,rv220w", "cavium,octeon-3860";

	chosen { stdout-path = "serial0:115200n8"; };

	aliases {
		uart0 = &uart0;
		serial0 = &uart0;
		pip = &pip;
		smi0 = &smi0;
		twsi0 = &twsi0;
	};

	rv220w-reset-keys {
		compatible = "gpio-keys";
		status = "disabled";
		reset {
			label = "reset/recovery";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&uart0 {
	clock-frequency = <400000000>;
	status = "okay";
};

&twsi0 { status = "okay"; };

&smi0 {
	status = "okay";

	switch@1e {
		compatible = "brcm,bcm53115";
		reg = <0x1e>;
		status = "okay";

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 { reg = <1>; label = "lan1"; };
			port@2 { reg = <2>; label = "lan2"; };
			port@3 { reg = <3>; label = "lan3"; };
			port@4 { reg = <4>; label = "lan4"; };

			port@8 {
				reg = <8>;
				label = "cpu";
				ethernet = <&rv220w_eth0>;
				phy-mode = "@PHY_MODE@";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&pip {
	status = "okay";
	interface@0 {
		status = "okay";
		rv220w_eth0: ethernet@0 { status = "okay"; };
		ethernet@1 { status = "disabled"; };
		ethernet@2 { status = "disabled"; };
	};
};

&usbn { status = "disabled"; };

&bootbus {
	status = "okay";
	/delete-node/ cavium,cs-config@0;
	/delete-node/ cavium,cs-config@4;
	/delete-node/ cavium,cs-config@5;
	/delete-node/ cavium,cs-config@6;
	/delete-node/ led-display@4,0;
	/delete-node/ compact-flash@5,0;
	nor@0,0 { status = "okay"; };
};
