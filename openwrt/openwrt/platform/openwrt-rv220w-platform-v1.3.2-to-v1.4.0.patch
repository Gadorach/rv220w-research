 define Device/cisco_rv220w
   DEVICE_VENDOR := Cisco
   DEVICE_MODEL := RV220W
@@ -16,5 +18,20 @@
 endef
 TARGET_DEVICES += cisco_rv220w
 
+define Device/cisco_rv220w_flash_stage
+  DEVICE_VENDOR := Cisco
+  DEVICE_MODEL := RV220W
+  DEVICE_VARIANT := NOR writer
