+  CMDLINE := $(RV220W_FLASH_STAGE_CMDLINE)
+  SUPPORTED_DEVICES += cisco,rv220w
+  IMAGES :=
+endef
+TARGET_DEVICES += cisco_rv220w_flash_stage
+
 ITUSROUTER_CMDLINE:=console=ttyS0,115200 root=/dev/mmcblk1p2 rootfstype=squashfs,ext4,f2fs rootwait
