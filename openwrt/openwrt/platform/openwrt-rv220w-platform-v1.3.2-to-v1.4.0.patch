+++ b/target/linux/octeon/image/Makefile
@@ -2,6 +2,8 @@
 TARGET_DEVICES += generic
 
 RV220W_CMDLINE:=-mtdparts=phys_mapped_flash:512k(boot-chain)ro,6m(stock-kernel)ro,16m(stock-rootfs)ro,1m(stock-data)ro,128k(legacy-env-gap)ro,8448k(vendor-tail)ro,128k(uboot-env)ro console=ttyS0,115200 loglevel=8 ignore_loglevel usbcore.nousb
+RV220W_FLASH_STAGE_CMDLINE:=-mtdparts=phys_mapped_flash:512k(boot-chain)ro,22m(openwrt-slot),1m(stock-data)ro,128k(legacy-env-gap)ro,8448k(vendor-tail)ro,128k(uboot-env)ro console=ttyS0,115200 loglevel=8 ignore_loglevel usbcore.nousb
