#!/bin/sh
# Narrow first-stage writer for the Cisco RV220W 32 MiB parallel NOR.
# The only permitted target is the 22 MiB openwrt-slot exposed by the
# RAM-boot writer profile. No bootloader/environment writes or reboot.
set -eu

EXPECTED_SIZE=23068672
EXPECTED_ERASE=131072
EXPECTED_TOKEN='RV220W_WRITE_OPENWRT_SLOT'
EXPECTED_RESTORE_TOKEN='RV220W_RESTORE_OPENWRT_SLOT'
EXPECTED_PROFILE='nor-writer'
SLOT_NAME='openwrt-slot'

fail() {
	echo "ERROR: $*" >&2
	exit 1
}

profile_value() {
	awk -F= -v key="$1" '$1 == key { print substr($0, index($0, "=") + 1); exit }' /etc/rv220w-build-profile 2>/dev/null || true
}

board_model() {
	cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null | tr -d '\000' || true
}

slot_line() {
	awk -F'[: ]+' -v name="\"$SLOT_NAME\"" '$4 == name { print $1, $2, $3; exit }' /proc/mtd 2>/dev/null
}

require_target() {
	model=$(board_model)
	case "$model" in
		*Cisco*RV220W*) ;;
		*) fail "unexpected board model: ${model:-<missing>}" ;;
	esac

	[ "$(profile_value profile)" = "$EXPECTED_PROFILE" ] ||
		fail "this image is not the dedicated RAM-boot NOR-writer profile"
	[ "$(profile_value writes)" = 'openwrt-slot-only' ] ||
		fail "writer policy marker is missing or invalid"

	set -- $(slot_line)
	[ "$#" -eq 3 ] || fail "MTD partition '$SLOT_NAME' is missing or ambiguous"
	MTD_NUM=${1#mtd}
	MTD_SIZE_HEX=$2
	MTD_ERASE_HEX=$3
	MTD_DEV="/dev/mtd$MTD_NUM"
	MTD_SIZE=$((0x$MTD_SIZE_HEX))
	MTD_ERASE=$((0x$MTD_ERASE_HEX))
	[ "$MTD_SIZE" -eq "$EXPECTED_SIZE" ] || fail "unexpected slot size: $MTD_SIZE"
	[ "$MTD_ERASE" -eq "$EXPECTED_ERASE" ] || fail "unexpected erase size: $MTD_ERASE"
	[ -c "$MTD_DEV" ] || fail "character MTD device is missing: $MTD_DEV"
	export MTD_NUM MTD_DEV MTD_SIZE MTD_ERASE
}

file_size() {
	wc -c < "$1" | tr -d '[:space:]'
}

file_sha() {
	sha256sum "$1" | awk '{ print $1 }'
}

slot_sha() {
	dd if="$MTD_DEV" bs="$MTD_ERASE" 2>/dev/null | sha256sum | awk '{ print $1 }'
}

validate_blob() {
	image=$1
	expected_sha=$2
	[ -f "$image" ] || fail "image not found: $image"
	actual_size=$(file_size "$image")
	[ "$actual_size" -eq "$EXPECTED_SIZE" ] ||
		fail "slot image must be exactly $EXPECTED_SIZE bytes; found $actual_size"
	case "$expected_sha" in
		????????????????????????????????????????????????????????????????) ;;
		*) fail "expected SHA-256 is malformed" ;;
	esac
	actual_sha=$(file_sha "$image")
	[ "$actual_sha" = "$expected_sha" ] ||
		fail "image SHA-256 mismatch: expected=$expected_sha actual=$actual_sha"
}

validate_openwrt_image() {
	validate_blob "$1" "$2"
	magic=$(hexdump -n 4 -e '4/1 "%02x"' "$1" 2>/dev/null || true)
	[ "$magic" = '7f454c46' ] || fail "OpenWrt slot image does not begin with an ELF header"
}

write_and_verify() {
	image=$1
	expected_sha=$2
	mtd write "$image" "$SLOT_NAME"
	actual=$(slot_sha)
	[ "$actual" = "$expected_sha" ] || fail "post-write NOR verification failed: expected=$expected_sha actual=$actual"
	echo "write=ok sha256=$actual"
}

usage() {
	cat >&2 <<'USAGE'
Usage:
  rv220w-nor-stage status
  rv220w-nor-stage hash
  rv220w-nor-stage backup
  rv220w-nor-stage verify EXPECTED_SHA256
  rv220w-nor-stage write FILE EXPECTED_SHA256 RV220W_WRITE_OPENWRT_SLOT
  rv220w-nor-stage restore FILE EXPECTED_SHA256 RV220W_RESTORE_OPENWRT_SLOT
USAGE
	exit 2
}

cmd=${1:-}
case "$cmd" in
	status)
		require_target
		printf '%s\n' \
			'board=Cisco RV220W' \
			'storage=32MiB-parallel-NOR' \
			'profile=nor-writer' \
			'writable_partition=openwrt-slot' \
			"mtd_device=$MTD_DEV" \
			"size=$MTD_SIZE" \
			"erasesize=$MTD_ERASE" \
			'protected=boot-chain,stock-data,legacy-env-gap,vendor-tail,uboot-env' \
			'automatic_reboot=no' \
			'automatic_saveenv=no'
		;;
	hash)
		require_target
		slot_sha
		;;
	backup)
		require_target
		dd if="$MTD_DEV" bs="$MTD_ERASE" 2>/dev/null
		;;
	verify)
		[ "$#" -eq 2 ] || usage
		require_target
		actual=$(slot_sha)
		[ "$actual" = "$2" ] || fail "NOR read-back SHA-256 mismatch: expected=$2 actual=$actual"
		echo "verify=ok sha256=$actual"
		;;
	write)
		[ "$#" -eq 4 ] || usage
		image=$2
		expected_sha=$3
		token=$4
		[ "$token" = "$EXPECTED_TOKEN" ] || fail "exact confirmation token is required"
		require_target
		validate_openwrt_image "$image" "$expected_sha"
		echo "Writing exactly $EXPECTED_SIZE bytes to $SLOT_NAME ($MTD_DEV)." >&2
		echo 'No other MTD partition is writable in this boot profile.' >&2
		write_and_verify "$image" "$expected_sha"
		echo 'No reboot or U-Boot environment change was performed.'
		echo 'At the U-Boot prompt, copy the ELF from NOR to RAM, then run bootoctlinux.'
		;;
	restore)
		[ "$#" -eq 4 ] || usage
		image=$2
		expected_sha=$3
		token=$4
		[ "$token" = "$EXPECTED_RESTORE_TOKEN" ] || fail "exact restore confirmation token is required"
		require_target
		validate_blob "$image" "$expected_sha"
		echo "Restoring exactly $EXPECTED_SIZE bytes to $SLOT_NAME ($MTD_DEV)." >&2
		echo 'No other MTD partition is writable in this boot profile.' >&2
		write_and_verify "$image" "$expected_sha"
		echo 'Restore and full read-back verification completed.'
		echo 'No reboot or U-Boot environment change was performed.'
		;;
	*) usage ;;
esac
