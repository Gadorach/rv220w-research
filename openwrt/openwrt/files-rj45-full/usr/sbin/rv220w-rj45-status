#!/bin/sh
# Read-only production-candidate status report.  No raw switch-register writes.
set -u

service_state() {
	service=$1
	if [ ! -x "/etc/init.d/$service" ]; then
		echo absent
	elif /etc/init.d/"$service" running >/dev/null 2>&1; then
		echo running
	else
		echo stopped
	fi
}

printf '%s\n' 'RV220W full-RJ45 validated-baseline status'
cat /etc/rv220w-build 2>/dev/null || true

printf '\n=== SECURITY ===\n'
root_hash=$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null || true)
if [ -n "$root_hash" ]; then
	echo 'root_password=set'
else
	echo 'root_password=unset (RAM image: run passwd before enabling remote administration)'
fi
uci -q show dropbear 2>/dev/null || true

printf '\n=== CONDUITS_AND_PORTS ===\n'
for dev in eth0 eth1 wan lan1 lan2 lan3 lan4 br-lan; do
	ip -d -s link show dev "$dev" 2>/dev/null || true
done

printf '\n=== BRIDGE ===\n'
bridge link show 2>/dev/null || true
bridge vlan show 2>/dev/null || true

printf '\n=== ADDRESSES_AND_ROUTES ===\n'
ip -br address 2>/dev/null || ip address
ip route show table all

printf '\n=== NETWORK ===\n'
uci -q show network

printf '\n=== DHCP ===\n'
uci -q show dhcp
printf '%s\n' '-- leases --'
cat /tmp/dhcp.leases 2>/dev/null || true

printf '\n=== FIREWALL ===\n'
uci -q show firewall
if nft list table inet fw4 >/dev/null 2>&1; then
	echo 'firewall=loaded'
else
	echo 'firewall=not-loaded'
fi

printf '\n=== SERVICES ===\n'
for service in network dnsmasq odhcpd dropbear; do
	printf '%s=%s\n' "$service" "$(service_state "$service")"
done

printf '\n=== WAN_STATUS ===\n'
ubus call network.interface.wan status 2>/dev/null || true
ubus call network.interface.wan6 status 2>/dev/null || true

printf '\n=== NOR_AND_DEVICE_TREE ===\n'
cat /proc/mtd 2>/dev/null || true
if [ -r /sys/firmware/fdt ]; then
	echo 'raw_fdt=available'
else
	echo 'raw_fdt=unavailable'
fi
printf 'kernel_tainted='
cat /proc/sys/kernel/tainted 2>/dev/null || echo unknown

printf '\n=== STANDARD_COUNTERS ===\n'
for dev in wan lan1 lan2 lan3 lan4 eth0 eth1; do
	printf '\n[%s]\n' "$dev"
	ethtool -S "$dev" 2>/dev/null || true
done


printf '\n=== COUNTER_INTERPRETATION ===\n'
echo 'The DSA wan netdev and end-to-end DHCP/routing tests are authoritative.'
echo 'On this dual-IMP BCM53115 topology, eth1 RX and B53 port-5 Tx counters may remain zero even while WAN ingress works.'
