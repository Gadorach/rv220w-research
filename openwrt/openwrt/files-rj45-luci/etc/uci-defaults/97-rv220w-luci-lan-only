#!/bin/sh
# Keep LuCI/uHTTPd reachable only through the validated LAN address.
# HTTPS is intentionally omitted from this size-constrained first stage.

uci -q delete uhttpd.main.listen_http
uci add_list uhttpd.main.listen_http='192.168.240.2:80'
uci -q delete uhttpd.main.listen_https
uci -q set uhttpd.main.redirect_https='0'
uci -q set uhttpd.main.rfc1918_filter='1'
uci commit uhttpd

logger -t rv220w 'LuCI enabled through uHTTPd on LAN address 192.168.240.2:80 only'
exit 0
