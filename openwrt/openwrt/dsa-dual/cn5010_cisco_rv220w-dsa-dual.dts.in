/*
 * Cisco RV220W RAM-only dual-conduit DSA validation device tree.
 *
 * Hardware evidence and v1.7.6 LAN validation map:
 *   BCM53115 port 0  -> WAN external PHY0
 *   BCM53115 port 5  -> Octeon eth1 WAN conduit
 *   BCM53115 ports 1-4 -> LAN1-LAN4
 *   BCM53115 port 8  -> Octeon eth0 LAN conduit
 *
 * DSA initially chooses the numerically first CPU port (port 5).  The
 * packaged early userspace affinity helper moves lan1-lan4 to eth0 before
 * netifd raises them, while wan remains assigned to eth1.  All switch state
 * and network configuration in this profile is volatile and RAM-only.
 */

/include/ "octeon_3xxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Cisco RV220W dual-conduit DSA validation (@VARIANT@)";
	compatible = "cisco,rv220w", "cavium,octeon-3860";

	chosen { stdout-path = "serial0:115200n8"; };

	aliases {
		uart0 = &uart0;
		serial0 = &uart0;
		pip = &pip;
		smi0 = &smi0;
		twsi0 = &twsi0;
	};

	rv220w-reset-keys {
		compatible = "gpio-keys";
		status = "disabled";
		reset {
			label = "reset/recovery";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&uart0 {
	clock-frequency = <400000000>;
	status = "okay";
};

&twsi0 { status = "okay"; };

&smi0 {
	status = "okay";

	switch@1e {
		compatible = "brcm,bcm53115";
		reg = <0x1e>;
		status = "okay";

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 { reg = <0>; label = "wan"; };
			port@1 { reg = <1>; label = "lan1"; };
			port@2 { reg = <2>; label = "lan2"; };
			port@3 { reg = <3>; label = "lan3"; };
			port@4 { reg = <4>; label = "lan4"; };

			port@5 {
				reg = <5>;
				label = "cpu-wan";
				ethernet = <&rv220w_eth1>;
				phy-mode = "@WAN_PHY_MODE@";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@8 {
				reg = <8>;
				label = "cpu-lan";
				ethernet = <&rv220w_eth0>;
				phy-mode = "rgmii-rxid";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&pip {
	status = "okay";
	interface@0 {
		status = "okay";
		rv220w_eth0: ethernet@0 { status = "okay"; };
		rv220w_eth1: ethernet@1 { status = "okay"; };
		ethernet@2 { status = "disabled"; };
	};
};

&usbn { status = "disabled"; };

&bootbus {
	status = "okay";
	/delete-node/ cavium,cs-config@0;
	/delete-node/ cavium,cs-config@4;
	/delete-node/ cavium,cs-config@5;
	/delete-node/ cavium,cs-config@6;
	/delete-node/ led-display@4,0;
	/delete-node/ compact-flash@5,0;
	nor@0,0 { status = "okay"; };
};
