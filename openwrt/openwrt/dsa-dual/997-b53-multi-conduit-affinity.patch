From: OpenWrt RV220W research <rv220w-research@invalid>
Subject: [PATCH] net: dsa: b53: support changing user-port conduits

B53 switches can expose more than one Broadcom-tag-capable CPU port, but
b53 currently lacks DSA's port_change_conduit callback.  Consequently DSA
cannot assign different user ports to different CPU conduits even when the
firmware describes both links.

Teach the driver to rebuild port-based VLAN membership from the DSA
user-to-CPU-port topology whenever a user port changes conduit.  Preserve
the existing single-CPU behavior, while keeping each user port and CPU port
in only its assigned conduit domain when multiple CPU ports are present.

This is switch-generic and contains no board or BCM53115-specific policy.

---
 drivers/net/dsa/b53/b53_common.c | 103 ++++++++++++++++++++++++++++++++++++
 1 file changed, 103 insertions(+)

--- a/drivers/net/dsa/b53/b53_common.c
+++ b/drivers/net/dsa/b53/b53_common.c
@@ -537,11 +537,90 @@ static int b53_fast_age_vlan(struct b53_device *dev, u16 vid)
 	return b53_flush_arl(dev, FAST_AGE_VLAN);
 }
 
+static int b53_multi_cpu_vlan_setup(struct dsa_switch *ds,
+				    int changed_port, int new_cpu_port)
+{
+	struct b53_device *dev = ds->priv;
+	struct dsa_port *dp, *user_dp;
+	u16 cpu_ports = dsa_cpu_ports(ds);
+	unsigned int i;
+	u16 pvlan;
+	int err;
+
+	/*
+	 * Rebuild only the port-based VLAN masks which select a CPU conduit.
+	 * Keep bridge/user-port membership intact on user ports, but make sure
+	 * that exactly one local CPU port is reachable from each user port.
+	 */
+	b53_for_each_port(dev, i) {
+		dp = dsa_to_port(ds, i);
+		if (!dp)
+			continue;
+
+		if (dsa_port_is_user(dp)) {
+			int cpu_port;
+
+			if (i == changed_port)
+				cpu_port = new_cpu_port;
+			else if (dp->cpu_dp)
+				cpu_port = dp->cpu_dp->index;
+			else
+				continue;
+
+			err = b53_read16(dev, B53_PVLAN_PAGE,
+					 B53_PVLAN_PORT_MASK(i), &pvlan);
+			if (err)
+				return err;
+
+			pvlan &= ~cpu_ports;
+			pvlan |= BIT(cpu_port);
+			err = b53_write16(dev, B53_PVLAN_PAGE,
+					  B53_PVLAN_PORT_MASK(i), pvlan);
+			if (err)
+				return err;
+
+			dev->ports[i].vlan_ctl_mask = pvlan;
+			continue;
+		}
+
+		if (!dsa_port_is_cpu(dp))
+			continue;
+
+		pvlan = BIT(i);
+		dsa_switch_for_each_user_port(user_dp, ds) {
+			int cpu_port;
+
+			if (user_dp->index == changed_port)
+				cpu_port = new_cpu_port;
+			else if (user_dp->cpu_dp)
+				cpu_port = user_dp->cpu_dp->index;
+			else
+				continue;
+
+			if (cpu_port == i)
+				pvlan |= BIT(user_dp->index);
+		}
+
+		err = b53_write16(dev, B53_PVLAN_PAGE,
+				  B53_PVLAN_PORT_MASK(i), pvlan);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
 void b53_imp_vlan_setup(struct dsa_switch *ds, int cpu_port)
 {
 	struct b53_device *dev = ds->priv;
 	unsigned int i;
 	u16 pvlan;
+
+	if (hweight16(dsa_cpu_ports(ds)) > 1) {
+		/* Keep the legacy void API: setup callers cannot report errors. */
+		b53_multi_cpu_vlan_setup(ds, -1, -1);
+		return;
+	}
 
 	/* BCM5325 CPU port is at 8 */
 	if ((is5325(dev) || is5365(dev)) && cpu_port == B53_CPU_PORT_25)
@@ -2473,6 +2533,29 @@ static bool b53_possible_cpu_port(struct dsa_switch *ds, int port)
 	return false;
 }
 
+static int b53_port_change_conduit(struct dsa_switch *ds, int port,
+				   struct net_device *conduit,
+				   struct netlink_ext_ack *extack)
+{
+	struct dsa_port *cpu_dp;
+
+	if (netif_is_lag_master(conduit)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "LAG DSA conduits are not supported");
+		return -EOPNOTSUPP;
+	}
+
+	cpu_dp = conduit->dsa_ptr;
+	if (!cpu_dp || cpu_dp->ds != ds || !dsa_port_is_cpu(cpu_dp) ||
+	    !b53_possible_cpu_port(ds, cpu_dp->index)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Interface is not a local B53 CPU conduit");
+		return -EINVAL;
+	}
+
+	return b53_multi_cpu_vlan_setup(ds, port, cpu_dp->index);
+}
+
 static bool b53_can_enable_brcm_tags(struct dsa_switch *ds, int port,
 				     enum dsa_tag_protocol tag_protocol)
 {
@@ -2699,6 +2782,7 @@ static const struct phylink_mac_ops b53_phylink_mac_ops = {
 
 static const struct dsa_switch_ops b53_switch_ops = {
 	.get_tag_protocol	= b53_get_tag_protocol,
+	.port_change_conduit	= b53_port_change_conduit,
 	.setup			= b53_setup,
 	.teardown		= b53_teardown,
 	.get_strings		= b53_get_strings,
-- 
2.49.0
