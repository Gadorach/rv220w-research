// SPDX-License-Identifier: GPL-2.0-only
/*
 * Cisco RV220W production-oriented full-RJ45 device tree.
 *
 * Hardware-proven topology:
 *   BCM53115 port 0      -> WAN external PHY0
 *   BCM53115 port 5      -> Octeon eth1 WAN conduit
 *   BCM53115 ports 1-4   -> LAN1-LAN4
 *   BCM53115 port 8      -> Octeon eth0 LAN conduit
 *
 * The Octeon MAC-to-switch connections are board-internal fixed 1 Gbit/s
 * links.  External carrier remains reported by the DSA user-port PHYs.
 * The NOR child uses an Octeon-specific compatible so the architecture
 * driver, not generic physmap, derives the true base, size and width from
 * U-Boot's live BootBus chip-select register.
 */

/include/ "octeon_3xxx.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Cisco RV220W full-RJ45 OpenWrt (rxid)";
	compatible = "cisco,rv220w", "cavium,octeon-3860";

	chosen { stdout-path = "serial0:115200n8"; };

	aliases {
		uart0 = &uart0;
		serial0 = &uart0;
		pip = &pip;
		smi0 = &smi0;
		twsi0 = &twsi0;
	};

	rv220w-leds {
		compatible = "gpio-leds";

		power {
			label = "rv220w:green:power";
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		diag {
			label = "rv220w:red:diag";
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		wlan {
			label = "rv220w:green:wlan";
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		dmz {
			label = "rv220w:green:dmz";
			gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	rv220w-reset-keys {
		compatible = "gpio-keys";
		status = "disabled";
		reset {
			label = "reset/recovery";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	/*
	 * BCM4322 calibration is read from the card's physical external SPROM.
	 * v1.14.13 hardware evidence proved that the legacy Broadcom driver reads
	 * every 16-bit SPROM word twice and retains the second transaction; the
	 * v1.14.14 RAM-only kernel patch mirrors that read sequence directly.
	 * No fallback-SPROM platform device is instantiated here.
	 */

};

&uart0 {
	clock-frequency = <400000000>;
	status = "okay";
};

&twsi0 { status = "okay"; };

&smi0 {
	status = "okay";

	switch@1e {
		compatible = "brcm,bcm53115";
		reg = <0x1e>;
		status = "okay";

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 { reg = <0>; label = "wan"; };
			port@1 { reg = <1>; label = "lan1"; };
			port@2 { reg = <2>; label = "lan2"; };
			port@3 { reg = <3>; label = "lan3"; };
			port@4 { reg = <4>; label = "lan4"; };

			port@5 {
				reg = <5>;
				label = "cpu-wan";
				ethernet = <&rv220w_eth1>;
				phy-mode = "rgmii-rxid";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@8 {
				reg = <8>;
				label = "cpu-lan";
				ethernet = <&rv220w_eth0>;
				phy-mode = "rgmii-rxid";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&pip {
	status = "okay";

	interface@0 {
		status = "okay";

		rv220w_eth0: ethernet@0 {
			status = "okay";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		rv220w_eth1: ethernet@1 {
			status = "okay";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		ethernet@2 { status = "disabled"; };
	};
};

&usbn { status = "disabled"; };

&bootbus {
	status = "okay";
	/delete-node/ cavium,cs-config@0;
	/delete-node/ cavium,cs-config@4;
	/delete-node/ cavium,cs-config@5;
	/delete-node/ cavium,cs-config@6;
	/delete-node/ led-display@4,0;
	/delete-node/ compact-flash@5,0;

	/*
	 * Retain this child: it instantiates Octeon's BootBus-aware MTD driver.
	 * Do not add bank-width or replace it with a generic physmap mapping.
	 */
	nor@0,0 {
		compatible = "cavium,octeon-3860-bootbus-flash";
		status = "okay";
	};
};
