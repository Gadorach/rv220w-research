 void b53_imp_vlan_setup(struct dsa_switch *ds, int cpu_port)
 {
 	struct b53_device *dev = ds->priv;
 	unsigned int i;
 	u16 pvlan;
+
+	if (hweight16(dsa_cpu_ports(ds)) > 1) {
+		/* Keep the legacy void API: setup callers cannot report errors. */
+		b53_multi_cpu_vlan_setup(ds, -1, -1);
+		return;
+	}
 
 	/* BCM5325 CPU port is at 8 */
 	if ((is5325(dev) || is5365(dev)) && cpu_port == B53_CPU_PORT_25)
@@ -2473,6 +2533,29 @@ static bool b53_possible_cpu_port(struct dsa_switch *ds, int port)
 	return false;
 }
 
+static int b53_port_change_conduit(struct dsa_switch *ds, int port,
+				   struct net_device *conduit,
+				   struct netlink_ext_ack *extack)
+{
+	struct dsa_port *cpu_dp;
+
+	if (netif_is_lag_master(conduit)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "LAG DSA conduits are not supported");
+		return -EOPNOTSUPP;
+	}
+
+	cpu_dp = conduit->dsa_ptr;
+	if (!cpu_dp || cpu_dp->ds != ds || !dsa_port_is_cpu(cpu_dp) ||
+	    !b53_possible_cpu_port(ds, cpu_dp->index)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Interface is not a local B53 CPU conduit");
+		return -EINVAL;
+	}
+
+	return b53_multi_cpu_vlan_setup(ds, port, cpu_dp->index);
+}
