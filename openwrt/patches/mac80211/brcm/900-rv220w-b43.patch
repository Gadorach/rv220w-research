+static ssize_t capabilities_read_file(struct b43_wldev *dev,
+				      char *buf, size_t bufsize)
+{
+	struct b43_bus_dev *bus = dev->dev;
+	struct ssb_sprom *sprom = bus->bus_sprom;
+	struct b43_phy *phy = &dev->phy;
+	struct b43_dfsentry *e = dev->dfsentry;
+	struct b43_pio_rxqueue *rxq = NULL;
+	u32 pio_rxctl = 0;
+	ssize_t count = 0;
+
+	fappend("driver=b43\n");
+	fappend("permanent_mac=%pM\n", dev->wl->hw->wiphy->perm_addr);
+	fappend("bus_type=%u\n", bus->bus_type);
+	fappend("board_vendor=0x%04x\n", bus->board_vendor);
+	fappend("board_type=0x%04x\n", bus->board_type);
+	fappend("board_rev=0x%04x\n", bus->board_rev);
+	fappend("chip_id=0x%04x\n", bus->chip_id);
+	fappend("chip_rev=%u\n", bus->chip_rev);
+	fappend("chip_pkg=%u\n", bus->chip_pkg);
+	fappend("core_id=0x%04x\n", bus->core_id);
+	fappend("core_rev=%u\n", bus->core_rev);
+	if (sprom) {
+		fappend("sprom_revision=%u\n", sprom->revision);
+		fappend("sprom_il0mac=%pM\n", sprom->il0mac);
+		fappend("sprom_et1mac=%pM\n", sprom->et1mac);
+		fappend("sprom_boardflags_lo=0x%04x\n", sprom->boardflags_lo);
+		fappend("sprom_boardflags_hi=0x%04x\n", sprom->boardflags_hi);
+		fappend("sprom_boardflags2_lo=0x%04x\n", sprom->boardflags2_lo);
+		fappend("sprom_boardflags2_hi=0x%04x\n", sprom->boardflags2_hi);
+	}
+	fappend("status=%d\n", b43_status(dev));
+	fappend("requested_transfer=%s\n", dev->use_pio ? "pio" : "dma");
+	fappend("active_transfer=%s\n",
+		b43_using_pio_transfers(dev) ? "pio" : "dma");
+	fappend("qos_enabled=%u\n", dev->qos_enabled);
+	fappend("hwcrypto_enabled=%u\n", dev->hwcrypto_enabled);
+	fappend("radio_hw_enable=%u\n", dev->radio_hw_enable);
+	fappend("phy_type=%u\n", phy->type);
+	fappend("phy_rev=%u\n", phy->rev);
+	fappend("phy_analog=%u\n", phy->analog);
+	fappend("radio_manuf=0x%04x\n", phy->radio_manuf);
+	fappend("radio_ver=0x%04x\n", phy->radio_ver);
+	fappend("radio_rev=%u\n", phy->radio_rev);
+	fappend("supports_2ghz=%u\n", phy->supports_2ghz);
+	fappend("supports_5ghz=%u\n", phy->supports_5ghz);
+	fappend("radio_on=%u\n", phy->radio_on);
+	fappend("hardware_power_control=%u\n", phy->hardware_power_control);
+	fappend("desired_txpower_dbm=%d\n", phy->desired_txpower);
+	fappend("channel=%u\n", phy->channel);
+	fappend("rxpath_irq_total=%u\n", e ? e->rv220w_rx_irq_total : 0);
+	fappend("rxpath_dma0_rx_done_total=%u\n", e ? e->rv220w_rx_dma0_done_total : 0);
+	fappend("rxpath_pio_dispatch_total=%u\n", e ? e->rv220w_rx_pio_dispatch_total : 0);
+	fappend("rxpath_pio_frame_ready_total=%u\n", e ? e->rv220w_rx_pio_frame_ready_total : 0);
+	fappend("rxpath_pio_data_ready_total=%u\n", e ? e->rv220w_rx_pio_data_ready_total : 0);
+	fappend("rxpath_pio_header_ok_total=%u\n", e ? e->rv220w_rx_pio_header_ok_total : 0);
+	fappend("rxpath_pio_timeout_total=%u\n", e ? e->rv220w_rx_pio_timeout_total : 0);
+	fappend("rxpath_pio_error_total=%u\n", e ? e->rv220w_rx_pio_error_total : 0);
+	fappend("rxpath_pio_len_error_total=%u\n", e ? e->rv220w_rx_pio_len_error_total : 0);
+	fappend("rxpath_pio_fcs_error_total=%u\n", e ? e->rv220w_rx_pio_fcs_error_total : 0);
+	fappend("rxpath_b43_enter_total=%u\n", e ? e->rv220w_rx_b43_enter_total : 0);
+	fappend("rxpath_b43_drop_total=%u\n", e ? e->rv220w_rx_b43_drop_total : 0);
+	fappend("rxpath_b43_delivered_total=%u\n", e ? e->rv220w_rx_mac80211_delivered_total : 0);
+	fappend("rxpath_last_irq_reason=0x%08x\n", e ? e->rv220w_rx_last_irq_reason : 0);
+	fappend("rxpath_last_dma0_reason=0x%08x\n", e ? e->rv220w_rx_last_dma0_reason : 0);
+	fappend("rxpath_irq_mask=0x%08x\n", dev->irq_mask);
+	fappend("rxpath_gen_irq_mask_live=0x%08x\n", b43_read32(dev, B43_MMIO_GEN_IRQ_MASK));
+	fappend("rxpath_gen_irq_reason_live=0x%08x\n", b43_read32(dev, B43_MMIO_GEN_IRQ_REASON));
+	fappend("rxpath_dma0_irq_mask_live=0x%08x\n", b43_read32(dev, B43_MMIO_DMA0_IRQ_MASK));
+	fappend("rxpath_dma0_reason_live=0x%08x\n", b43_read32(dev, B43_MMIO_DMA0_REASON));
+	fappend("rxpath_macctl=0x%08x\n", b43_read32(dev, B43_MMIO_MACCTL));
+	fappend("rxpath_mac_suspended=%d\n", dev->mac_suspended);
+	fappend("rxpath_operating=%u\n", dev->wl->operating);
+	fappend("rxpath_if_type=%d\n", dev->wl->if_type);
+	fappend("rxpath_filter_flags=0x%08x\n", dev->wl->filter_flags);
+	if (b43_using_pio_transfers(dev) && dev->pio.rx_queue) {
+		rxq = dev->pio.rx_queue;
+		pio_rxctl = rxq->rev >= 8 ?
+			b43_piorx_read32(rxq, B43_PIO8_RXCTL) :
+			b43_piorx_read16(rxq, B43_PIO_RXCTL);
+		fappend("rxpath_pio_rx_rev=%u\n", rxq->rev);
+		fappend("rxpath_pio_rx_mmio_base=0x%04x\n", rxq->mmio_base);
+		fappend("rxpath_pio_rxctl=0x%08x\n", pio_rxctl);
+	}
+
+	return count;
+}
