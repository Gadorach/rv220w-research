+static int nphy_rxiq_cal_write_file(struct b43_wldev *dev,
+                                    const char *buf, size_t count)
+{
+       struct b43_dfsentry *e = dev->dfsentry;
+       struct b43_phy_n_iq_comp before, after, saved;
+       struct b43_nphy_rxiq_diag_status diag_status = { };
+       bool cleanup_complete = false;
+       bool resume_ok;
+       int rc;
+
+       if (sysfs_streq(buf, "run")) {
+               if (e->rxiq_diag_active)
+                       return -EBUSY;
+               if (b43_status(dev) != B43_STAT_STARTED ||
+                   dev->phy.type != B43_PHYTYPE_N || dev->phy.rev != 4 ||
+                   dev->phy.radio_ver != 0x2056 || dev->phy.radio_rev != 3 ||
+                   (dev->phy.channel < 1 || dev->phy.channel > 11) || !b43_using_pio_transfers(dev))
+                       return -EOPNOTSUPP;
+
+               e->rxiq_diag_saved_valid = false;
+               e->rxiq_diag_active = false;
+               e->rxiq_diag_restore_verified = false;
+               e->rxiq_diag_cleanup_complete = false;
+               e->rxiq_diag_run_mac_suspend_verified = false;
+               e->rxiq_diag_run_mac_resume_verified = false;
+               e->rxiq_diag_restore_mac_suspend_verified = false;
+               e->rxiq_diag_restore_mac_resume_verified = false;
+               e->rxiq_diag_cleanup_fail_mask = 0;
+               e->rxiq_diag_primary_rc = 0;
+               e->rxiq_diag_failure_stage = 0;
+               memset(e->rxiq_diag_gain_saved, 0, sizeof(e->rxiq_diag_gain_saved));
+               memset(e->rxiq_diag_gain_observed, 0, sizeof(e->rxiq_diag_gain_observed));
+               memset(e->rxiq_diag_radio_spare_saved, 0, sizeof(e->rxiq_diag_radio_spare_saved));
+               memset(e->rxiq_diag_radio_spare_observed, 0, sizeof(e->rxiq_diag_radio_spare_observed));
+               e->rxiq_diag_deaf_before = 0;
+               e->rxiq_diag_deaf_after = 0;
+               memset(e->rxiq_diag_pass_i_pwr, 0, sizeof(e->rxiq_diag_pass_i_pwr));
+               memset(e->rxiq_diag_pass_q_pwr, 0, sizeof(e->rxiq_diag_pass_q_pwr));
+               memset(e->rxiq_diag_pass_iq_prod, 0, sizeof(e->rxiq_diag_pass_iq_prod));
+               memset(e->rxiq_diag_pass_power, 0, sizeof(e->rxiq_diag_pass_power));
+               memset(e->rxiq_diag_pass_packed_gain, 0, sizeof(e->rxiq_diag_pass_packed_gain));
+               memset(e->rxiq_diag_final_i_pwr, 0, sizeof(e->rxiq_diag_final_i_pwr));
+               memset(e->rxiq_diag_final_q_pwr, 0, sizeof(e->rxiq_diag_final_q_pwr));
+               memset(e->rxiq_diag_final_iq_prod, 0, sizeof(e->rxiq_diag_final_iq_prod));
+               memset(e->rxiq_diag_calc_error, 0, sizeof(e->rxiq_diag_calc_error));
+               e->rxiq_diag_calc_applied_mask = 0;
+
+               /* Establish rollback data before any calibration mutation. */
+               b43_nphy_rxiq_read_diag(dev, &before);
+               after = before;
+               rxiq_diag_store_comp(e->rxiq_diag_saved, &before);
+               rxiq_diag_store_comp(e->rxiq_diag_after, &after);
+               e->rxiq_diag_saved_valid = true;
+
+               rc = rxiq_diag_mac_suspend(dev);
+               e->rxiq_diag_run_mac_suspend_verified = (rc == 0);
+               if (rc) {
+                       e->rxiq_diag_last_rc = rc;
+                       e->rxiq_diag_run_mac_resume_verified =
+                               dev->mac_suspended == 0 &&
+                               (b43_read32(dev, B43_MMIO_MACCTL) &
+                                B43_MACCTL_ENABLED);
+                       return rc;
+               }
+
+               rc = b43_nphy_rxiq_cal_diag(dev, &before, &after,
+                                           &cleanup_complete, &diag_status);
+               e->rxiq_diag_cleanup_fail_mask = diag_status.cleanup_fail_mask;
+               e->rxiq_diag_primary_rc = diag_status.primary_rc;
+               e->rxiq_diag_failure_stage = diag_status.failure_stage;
+               e->rxiq_diag_gain_saved[0] = diag_status.gain_saved[0];
+               e->rxiq_diag_gain_saved[1] = diag_status.gain_saved[1];
+               e->rxiq_diag_gain_observed[0] = diag_status.gain_observed[0];
+               e->rxiq_diag_gain_observed[1] = diag_status.gain_observed[1];
+               e->rxiq_diag_radio_spare_saved[0] = diag_status.radio_spare_saved[0];
+               e->rxiq_diag_radio_spare_saved[1] = diag_status.radio_spare_saved[1];
+               e->rxiq_diag_radio_spare_observed[0] = diag_status.radio_spare_observed[0];
+               e->rxiq_diag_radio_spare_observed[1] = diag_status.radio_spare_observed[1];
+               e->rxiq_diag_deaf_before = diag_status.deaf_before;
+               e->rxiq_diag_deaf_after = diag_status.deaf_after;
+               memcpy(e->rxiq_diag_pass_i_pwr, diag_status.pass_i_pwr, sizeof(e->rxiq_diag_pass_i_pwr));
+               memcpy(e->rxiq_diag_pass_q_pwr, diag_status.pass_q_pwr, sizeof(e->rxiq_diag_pass_q_pwr));
+               memcpy(e->rxiq_diag_pass_iq_prod, diag_status.pass_iq_prod, sizeof(e->rxiq_diag_pass_iq_prod));
+               memcpy(e->rxiq_diag_pass_power, diag_status.pass_power, sizeof(e->rxiq_diag_pass_power));
+               memcpy(e->rxiq_diag_pass_packed_gain, diag_status.pass_packed_gain, sizeof(e->rxiq_diag_pass_packed_gain));
+               memcpy(e->rxiq_diag_final_i_pwr, diag_status.final_i_pwr, sizeof(e->rxiq_diag_final_i_pwr));
+               memcpy(e->rxiq_diag_final_q_pwr, diag_status.final_q_pwr, sizeof(e->rxiq_diag_final_q_pwr));
+               memcpy(e->rxiq_diag_final_iq_prod, diag_status.final_iq_prod, sizeof(e->rxiq_diag_final_iq_prod));
+               memcpy(e->rxiq_diag_calc_error, diag_status.calc_error, sizeof(e->rxiq_diag_calc_error));
+               e->rxiq_diag_calc_applied_mask = diag_status.calc_applied_mask;
+               resume_ok = rxiq_diag_mac_resume(dev);
+               e->rxiq_diag_run_mac_resume_verified = resume_ok;
+               if (!resume_ok && !rc)
+                       rc = -EIO;
+
+               rxiq_diag_store_comp(e->rxiq_diag_saved, &before);
+               rxiq_diag_store_comp(e->rxiq_diag_after, &after);
+               e->rxiq_diag_last_rc = rc;
+               e->rxiq_diag_cleanup_complete = cleanup_complete;
+               e->rxiq_diag_active =
+                       (rc == 0 && cleanup_complete && resume_ok);
+               return rc;
+       }
+
+       if (sysfs_streq(buf, "restore")) {
+               if (!e->rxiq_diag_saved_valid)
+                       return -ENOENT;
+               if (b43_status(dev) != B43_STAT_STARTED ||
+                   dev->phy.type != B43_PHYTYPE_N || dev->phy.rev != 4 ||
+                   dev->phy.radio_ver != 0x2056 || dev->phy.radio_rev != 3 ||
+                   (dev->phy.channel < 1 || dev->phy.channel > 11) || !b43_using_pio_transfers(dev))
+                       return -EOPNOTSUPP;
+
+               e->rxiq_diag_restore_verified = false;
+               e->rxiq_diag_restore_mac_suspend_verified = false;
+               e->rxiq_diag_restore_mac_resume_verified = false;
+               rxiq_diag_load_comp(&saved, e->rxiq_diag_saved);
+
+               rc = rxiq_diag_mac_suspend(dev);
+               e->rxiq_diag_restore_mac_suspend_verified = (rc == 0);
+               if (rc) {
+                       e->rxiq_diag_last_rc = rc;
+                       e->rxiq_diag_restore_mac_resume_verified =
+                               dev->mac_suspended == 0 &&
+                               (b43_read32(dev, B43_MMIO_MACCTL) &
+                                B43_MACCTL_ENABLED);
+                       return rc;
+               }
+
+               rc = b43_nphy_rxiq_restore_diag(dev, &saved);
+               resume_ok = rxiq_diag_mac_resume(dev);
+               e->rxiq_diag_restore_mac_resume_verified = resume_ok;
+               if (!resume_ok && !rc)
+                       rc = -EIO;
+               e->rxiq_diag_last_rc = rc;
+               e->rxiq_diag_restore_verified = (rc == 0 && resume_ok);
+               if (!rc && resume_ok)
+                       e->rxiq_diag_active = false;
+               return rc;
+       }
+
+       return -EINVAL;
+}
