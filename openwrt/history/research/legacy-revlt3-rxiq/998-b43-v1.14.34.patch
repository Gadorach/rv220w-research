+/*
+ * RV220W rev4/BCM2056 RX-IQ reconstruction diagnostic.
+ *
+ * This intentionally does not replace b43_nphy_rev3_cal_rx_iq().  It is
+ * reachable only through the explicit debugfs diagnostic gate.  The sequence
+ * mirrors the Broadcom 5.60.120.9 rev3-6 path observed on the RV220W and the
+ * existing b43 rev2 implementation, with stock-RV220W corrections:
+ *   - measured power is indexed by gain pass, not RX core;
+ *   - fourth-pass HPF adjustment uses signal bit-width (fls), not popcount;
+ *   - D6/E2 are temporary low-two-bit selectors and cleanup clears those
+ *     bits rather than restoring/comparing an entire readback value.
+ *
+ * The shipping Broadcom N-PHY state initializes rxcalparams to 0x010100B5.
+ * b43 currently leaves nphy->rxcalparams at zero on this target, so this
+ * diagnostic uses that stock value locally without changing normal b43 state.
+ */
+#define B43_NPHY_RXIQ_DIAG_RXCALPARAMS	0x010100B5
+
+void b43_nphy_rxiq_read_diag(struct b43_wldev *dev,
+			     struct b43_phy_n_iq_comp *comp)
+{
+	b43_nphy_rx_iq_coeffs(dev, false, comp);
+}
+
+int b43_nphy_rxiq_restore_diag(struct b43_wldev *dev,
+			       const struct b43_phy_n_iq_comp *saved)
+{
+	struct b43_phy_n_iq_comp restore;
+	struct b43_phy_n_iq_comp verify;
+
+	if (!saved || dev->phy.type != B43_PHYTYPE_N)
+		return -EINVAL;
+
+	restore = *saved;
+	b43_nphy_rx_iq_coeffs(dev, true, &restore);
+	b43_nphy_rx_iq_coeffs(dev, false, &verify);
+	if (verify.a0 != saved->a0 || verify.b0 != saved->b0 ||
+	    verify.a1 != saved->a1 || verify.b1 != saved->b1)
+		return -EIO;
+
+	return 0;
+}
+
+/* Diagnostic form of CalcRxIqComp. The normal b43 helper stays untouched.
+ * This preserves the upstream coefficient math while exposing the final
+ * 16384-sample estimator and the reason it would silently restore old
+ * coefficients.
+ */
+static int b43_nphy_calc_rx_iq_comp_diag(struct b43_wldev *dev, u8 mask,
+					 int core,
+					 struct b43_nphy_rxiq_diag_status *diag)
+{
+	struct nphy_iq_est est;
+	struct b43_phy_n_iq_comp old;
+	struct b43_phy_n_iq_comp new = { };
+	s32 iq;
+	u32 ii, qq;
+	int iq_nbits, qq_nbits;
+	int arsh, brsh;
+	u16 tmp, a, b;
+	u32 radicand;
+
+	if (!mask || core < 0 || core > 1 || !diag)
+		return -EINVAL;
+
+	b43_nphy_rx_iq_coeffs(dev, false, &old);
+	b43_nphy_rx_iq_coeffs(dev, true, &new);
+	b43_nphy_rx_iq_est(dev, &est, 0x4000, 32, false);
+	new = old;
+
+	if (core == 0) {
+		iq = est.iq0_prod;
+		ii = est.i0_pwr;
+		qq = est.q0_pwr;
+	} else {
+		iq = est.iq1_prod;
+		ii = est.i1_pwr;
+		qq = est.q1_pwr;
+	}
+	diag->final_i_pwr[core] = ii;
+	diag->final_q_pwr[core] = qq;
+	diag->final_iq_prod[core] = iq;
+
+	if (ii + qq < 2) {
+		diag->calc_error[core] = 1;
+		b43_nphy_rx_iq_coeffs(dev, true, &old);
+		return -ERANGE;
+	}
+
+	iq_nbits = fls(abs(iq));
+	qq_nbits = fls(qq);
+	arsh = iq_nbits - 20;
+	if (arsh >= 0) {
+		a = -((iq << (30 - iq_nbits)) + (ii >> (1 + arsh)));
+		tmp = ii >> arsh;
+	} else {
+		a = -((iq << (30 - iq_nbits)) + (ii << (-1 - arsh)));
+		tmp = ii << -arsh;
+	}
+	if (!tmp) {
+		diag->calc_error[core] = 2;
+		b43_nphy_rx_iq_coeffs(dev, true, &old);
+		return -ERANGE;
+	}
+	a /= tmp;
+
+	brsh = qq_nbits - 11;
+	b = qq << (31 - qq_nbits);
+	if (brsh >= 0)
+		tmp = ii >> brsh;
+	else
+		tmp = ii << -brsh;
+	if (!tmp) {
+		diag->calc_error[core] = 3;
+		b43_nphy_rx_iq_coeffs(dev, true, &old);
+		return -ERANGE;
+	}
+	radicand = b / tmp - a * a;
+	b = int_sqrt(radicand) - (1 << 10);
+
+	if (core == 0 && (mask & 0x1)) {
+		new.a0 = a & 0x3FF;
+		new.b0 = b & 0x3FF;
+	} else if (core == 1 && (mask & 0x2)) {
+		new.a1 = a & 0x3FF;
+		new.b1 = b & 0x3FF;
+	} else {
+		diag->calc_error[core] = 4;
+		b43_nphy_rx_iq_coeffs(dev, true, &old);
+		return -EINVAL;
+	}
+
+	b43_nphy_rx_iq_coeffs(dev, true, &new);
+	diag->calc_applied_mask |= BIT(core);
+	return 0;
+}
+
+int b43_nphy_rxiq_cal_diag(struct b43_wldev *dev,
+			   struct b43_phy_n_iq_comp *before,
+			   struct b43_phy_n_iq_comp *after,
+			   bool *cleanup_complete,
+			   struct b43_nphy_rxiq_diag_status *diag)
+{
+	static const u16 lna[3] = { 3, 3, 1 };
+	static const u16 hpf1[3] = { 7, 2, 0 };
+	static const u16 hpf2[3] = { 2, 0, 0 };
+	const u32 rxcalparams = B43_NPHY_RXIQ_DIAG_RXCALPARAMS;
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct nphy_txgains target;
+	struct nphy_iqcal_params cal_params[2];
+	struct nphy_iq_est est;
+	u16 gain_save[2], gain_verify[2], cal_gain[2];
+	u16 radio_spare1, radio_spare2;
+	u32 deaf_before;
+	bool carrier_held = false;
+	bool restore_ok = true;
+	bool playtone = true;
+	int ret = 0;
+	int core;
+
+	if (cleanup_complete)
+		*cleanup_complete = false;
+	if (diag)
+		memset(diag, 0, sizeof(*diag));
+	if (!before || !after || !nphy || !diag)
+		return -EINVAL;
+	if (dev->phy.type != B43_PHYTYPE_N || dev->phy.rev != 4 ||
+	    dev->phy.radio_ver != 0x2056 || dev->phy.radio_rev != 3 ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ ||
+	    (dev->phy.channel < 1 || dev->phy.channel > 11))
+		return -EOPNOTSUPP;
+
+	b43_nphy_rx_iq_coeffs(dev, false, before);
+	*after = *before;
+	target = b43_nphy_get_tx_gains(dev);
+	deaf_before = nphy->deaf_count;
+	radio_spare1 = b43_radio_read(dev, B2055_C1_GENSPARE2);
+	radio_spare2 = b43_radio_read(dev, B2055_C2_GENSPARE2);
+	diag->radio_spare_saved[0] = radio_spare1;
+	diag->radio_spare_saved[1] = radio_spare2;
+	diag->deaf_before = deaf_before;
+
+	b43_nphy_stay_in_carrier_search(dev, true);
+	carrier_held = true;
+	b43_ntab_read_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+	diag->gain_saved[0] = gain_save[0];
+	diag->gain_saved[1] = gain_save[1];
+	for (core = 0; core < 2; core++) {
+		b43_nphy_iq_cal_gain_params(dev, core, target,
+					    &cal_params[core]);
+		cal_gain[core] = cal_params[core].cal_gain;
+	}
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, cal_gain);
+
+	for (core = 0; core < 2; core++) {
+		u16 rfctl_rx, rfctl_tx, afectl_core;
+		u16 saved_rfseqca, saved_afectl, saved_afectl_over;
+		u16 saved_rfctl_rx, saved_rfctl_tx;
+		u32 power[3] = { 0, 0, 0 };
+		int pass;
+
+		if (core == 0) {
+			rfctl_rx = B43_NPHY_RFCTL_INTC1;
+			rfctl_tx = B43_NPHY_RFCTL_INTC2;
+			afectl_core = B43_NPHY_AFECTL_C1;
+		} else {
+			rfctl_rx = B43_NPHY_RFCTL_INTC2;
+			rfctl_tx = B43_NPHY_RFCTL_INTC1;
+			afectl_core = B43_NPHY_AFECTL_C2;
+		}
+
+		saved_rfseqca = b43_phy_read(dev, B43_NPHY_RFSEQCA);
+		saved_afectl = b43_phy_read(dev, afectl_core);
+		saved_afectl_over = b43_phy_read(dev, B43_NPHY_AFECTL_OVER);
+		saved_rfctl_rx = b43_phy_read(dev, rfctl_rx);
+		saved_rfctl_tx = b43_phy_read(dev, rfctl_tx);
+
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA,
+				~B43_NPHY_RFSEQCA_RXDIS & 0xFFFF,
+				((1 - core) << B43_NPHY_RFSEQCA_RXDIS_SHIFT));
+		b43_phy_maskset(dev, B43_NPHY_RFSEQCA,
+				~B43_NPHY_RFSEQCA_TXEN, (1 - core));
+		b43_phy_set(dev, afectl_core, 0x0006);
+		b43_phy_set(dev, B43_NPHY_AFECTL_OVER, 0x0006);
+		/* Stock rev3-6 uses the 2 GHz RFCTL pair 0x110/0x114. */
+		b43_phy_write(dev, rfctl_rx, 0x110);
+		b43_phy_write(dev, rfctl_tx, 0x114);
+
+		if (rxcalparams & 0x10000) {
+			b43_radio_maskset(dev, B2055_C1_GENSPARE2, 0xFC,
+					 (core + 1));
+			b43_radio_maskset(dev, B2055_C2_GENSPARE2, 0xFC,
+					 (2 - core));
+		}
+
+		for (pass = 0; pass < 4; pass++) {
+			u16 cur_lna, cur_hpf1, cur_hpf2;
+			u16 packed_gain;
+			int cur_hpf, index, use;
+
+			if (pass < 3) {
+				cur_lna = lna[pass];
+				cur_hpf1 = hpf1[pass];
+				cur_hpf2 = hpf2[pass];
+			} else {
+				if (power[1] > 10000) {
+					use = 1;
+					index = 2;
+					cur_hpf = hpf1[index];
+				} else if (power[0] > 10000) {
+					use = 1;
+					index = 1;
+					cur_hpf = hpf1[index];
+				} else {
+					use = 2;
+					index = 0;
+					cur_hpf = hpf2[index];
+				}
+				cur_lna = lna[index];
+				cur_hpf1 = hpf1[index];
+				cur_hpf2 = hpf2[index];
+				cur_hpf += 13 - fls(power[index]);
+				cur_hpf = clamp_val(cur_hpf, 0, 10);
+				if (use == 1)
+					cur_hpf1 = cur_hpf;
+				else
+					cur_hpf2 = cur_hpf;
+			}
+
+			packed_gain = (cur_hpf2 << 8) | (cur_hpf1 << 4) |
+				      (cur_lna << 2);
+			diag->pass_packed_gain[core][pass] = packed_gain;
+			b43_nphy_rf_ctl_override(dev, 0x400, packed_gain, 3,
+						 false);
+			b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+			if (b43_phy_read(dev, B43_NPHY_RFSEQST) &
+			    B43_NPHY_RFSEQTR_RST2RX) {
+				ret = -ETIMEDOUT;
+				diag->failure_stage = core ? 3 : 1;
+				break;
+			}
+			b43_nphy_stop_playback(dev);
+
+			if (playtone) {
+				ret = b43_nphy_tx_tone(dev, 4000,
+						       rxcalparams & 0xFFFF,
+						       false, false, true);
+				playtone = false;
+			} else {
+				b43_nphy_run_samples(dev, 160, 0xFFFF, 0,
+						     false, false, true);
+			}
+			if (ret) {
+				diag->failure_stage = core ? 4 : 2;
+				break;
+			}
+
+			if (pass < 3) {
+				u32 real, imag;
+				s32 iqprod;
+
+				b43_nphy_rx_iq_est(dev, &est, 1024, 32, false);
+				if (core == 0) {
+					real = est.i0_pwr;
+					imag = est.q0_pwr;
+					iqprod = est.iq0_prod;
+				} else {
+					real = est.i1_pwr;
+					imag = est.q1_pwr;
+					iqprod = est.iq1_prod;
+				}
+				diag->pass_i_pwr[core][pass] = real;
+				diag->pass_q_pwr[core][pass] = imag;
+				diag->pass_iq_prod[core][pass] = iqprod;
+				power[pass] = DIV_ROUND_CLOSEST(real, 1024) +
+					      DIV_ROUND_CLOSEST(imag, 1024) + 1;
+				diag->pass_power[core][pass] = power[pass];
+			} else {
+				ret = b43_nphy_calc_rx_iq_comp_diag(dev, 1 << core,
+								core, diag);
+				if (ret) {
+					diag->failure_stage = core ? 7 : 6;
+					break;
+				}
+			}
+			b43_nphy_stop_playback(dev);
+		}
+
+		b43_nphy_stop_playback(dev);
+		/* Stock wl.ko clears only the temporary low-two-bit selectors. */
+		b43_radio_mask(dev, B2055_C1_GENSPARE2, 0xFFFC);
+		b43_radio_mask(dev, B2055_C2_GENSPARE2, 0xFFFC);
+		b43_phy_write(dev, rfctl_tx, saved_rfctl_tx);
+		b43_phy_write(dev, rfctl_rx, saved_rfctl_rx);
+		b43_phy_write(dev, B43_NPHY_AFECTL_OVER, saved_afectl_over);
+		b43_phy_write(dev, afectl_core, saved_afectl);
+		b43_phy_write(dev, B43_NPHY_RFSEQCA, saved_rfseqca);
+
+		if (b43_phy_read(dev, rfctl_tx) != saved_rfctl_tx)
+			diag->cleanup_fail_mask |= BIT(core * 5 + 0);
+		if (b43_phy_read(dev, rfctl_rx) != saved_rfctl_rx)
+			diag->cleanup_fail_mask |= BIT(core * 5 + 1);
+		if (b43_phy_read(dev, B43_NPHY_AFECTL_OVER) != saved_afectl_over)
+			diag->cleanup_fail_mask |= BIT(core * 5 + 2);
+		if (b43_phy_read(dev, afectl_core) != saved_afectl)
+			diag->cleanup_fail_mask |= BIT(core * 5 + 3);
+		if (b43_phy_read(dev, B43_NPHY_RFSEQCA) != saved_rfseqca)
+			diag->cleanup_fail_mask |= BIT(core * 5 + 4);
+		if (diag->cleanup_fail_mask & (0x1F << (core * 5)))
+			restore_ok = false;
+		if (ret)
+			break;
+	}
+
+	b43_nphy_rf_ctl_override(dev, 0x400, 0, 3, true);
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+	if (b43_phy_read(dev, B43_NPHY_RFSEQST) &
+	    B43_NPHY_RFSEQTR_RST2RX) {
+		diag->cleanup_fail_mask |= BIT(10);
+		restore_ok = false;
+	}
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+	/* Match the stock RV220W cleanup invariant exactly: D6/E2 are
+	 * low-two-bit temporary controls, not full-value saved state. */
+	b43_radio_mask(dev, B2055_C1_GENSPARE2, 0xFFFC);
+	b43_radio_mask(dev, B2055_C2_GENSPARE2, 0xFFFC);
+	if (carrier_held)
+		b43_nphy_stay_in_carrier_search(dev, false);
+
+	b43_ntab_read_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_verify);
+	diag->gain_observed[0] = gain_verify[0];
+	diag->gain_observed[1] = gain_verify[1];
+	diag->radio_spare_observed[0] =
+		b43_radio_read(dev, B2055_C1_GENSPARE2);
+	diag->radio_spare_observed[1] =
+		b43_radio_read(dev, B2055_C2_GENSPARE2);
+	diag->deaf_after = nphy->deaf_count;
+	if (gain_verify[0] != gain_save[0])
+		diag->cleanup_fail_mask |= BIT(11);
+	if (gain_verify[1] != gain_save[1])
+		diag->cleanup_fail_mask |= BIT(12);
+	if (diag->radio_spare_observed[0] & 0x0003)
+		diag->cleanup_fail_mask |= BIT(13);
+	if (diag->radio_spare_observed[1] & 0x0003)
+		diag->cleanup_fail_mask |= BIT(14);
+	if (nphy->deaf_count != deaf_before)
+		diag->cleanup_fail_mask |= BIT(15);
+	if (diag->cleanup_fail_mask)
+		restore_ok = false;
+
+	diag->primary_rc = ret;
+	if (!restore_ok && !ret) {
+		diag->failure_stage = 5;
+		ret = -EIO;
+	}
+
+	/* Snapshot the coefficients produced by the reconstruction before the
+	 * fail-closed rollback restores the original tuple. */
+	b43_nphy_rx_iq_coeffs(dev, false, after);
+	if (ret)
+		b43_nphy_rx_iq_coeffs(dev, true, before);
+	if (cleanup_complete)
+		*cleanup_complete = restore_ok;
+
+	return ret;
+}
+
 const struct b43_phy_operations b43_phyops_n = {
