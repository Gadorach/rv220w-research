+#include <linux/delay.h>
+#include "phy_n.h"
+#include "radio_2056.h"
+
+static ssize_t capabilities_read_file(struct b43_wldev *dev,
+				      char *buf, size_t bufsize)
+{
+	struct b43_bus_dev *bus = dev->dev;
+	struct ssb_sprom *sprom = bus->bus_sprom;
+	struct b43_phy *phy = &dev->phy;
+	ssize_t count = 0;
+
+	fappend("driver=b43\n");
+	fappend("permanent_mac=%pM\n", dev->wl->hw->wiphy->perm_addr);
+	fappend("bus_type=%u\n", bus->bus_type);
+	fappend("board_vendor=0x%04x\n", bus->board_vendor);
+	fappend("board_type=0x%04x\n", bus->board_type);
+	fappend("board_rev=0x%04x\n", bus->board_rev);
+	fappend("chip_id=0x%04x\n", bus->chip_id);
+	fappend("chip_rev=%u\n", bus->chip_rev);
+	fappend("chip_pkg=%u\n", bus->chip_pkg);
+	fappend("core_id=0x%04x\n", bus->core_id);
+	fappend("core_rev=%u\n", bus->core_rev);
+	if (sprom) {
+		fappend("sprom_revision=%u\n", sprom->revision);
+		fappend("sprom_il0mac=%pM\n", sprom->il0mac);
+		fappend("sprom_et1mac=%pM\n", sprom->et1mac);
+		fappend("sprom_boardflags_lo=0x%04x\n", sprom->boardflags_lo);
+		fappend("sprom_boardflags_hi=0x%04x\n", sprom->boardflags_hi);
+		fappend("sprom_boardflags2_lo=0x%04x\n", sprom->boardflags2_lo);
+		fappend("sprom_boardflags2_hi=0x%04x\n", sprom->boardflags2_hi);
+	}
+	fappend("status=%d\n", b43_status(dev));
+	fappend("requested_transfer=%s\n", dev->use_pio ? "pio" : "dma");
+	fappend("active_transfer=%s\n",
+		b43_using_pio_transfers(dev) ? "pio" : "dma");
+	fappend("qos_enabled=%u\n", dev->qos_enabled);
+	fappend("hwcrypto_enabled=%u\n", dev->hwcrypto_enabled);
+	fappend("radio_hw_enable=%u\n", dev->radio_hw_enable);
+	fappend("phy_type=%u\n", phy->type);
+	fappend("phy_rev=%u\n", phy->rev);
+	fappend("phy_analog=%u\n", phy->analog);
+	fappend("radio_manuf=0x%04x\n", phy->radio_manuf);
+	fappend("radio_ver=0x%04x\n", phy->radio_ver);
+	fappend("radio_rev=%u\n", phy->radio_rev);
+	fappend("supports_2ghz=%u\n", phy->supports_2ghz);
+	fappend("supports_5ghz=%u\n", phy->supports_5ghz);
+	fappend("radio_on=%u\n", phy->radio_on);
+	fappend("hardware_power_control=%u\n", phy->hardware_power_control);
+	fappend("desired_txpower_dbm=%d\n", phy->desired_txpower);
+	fappend("channel=%u\n", phy->channel);
+
+	return count;
+}
+
+/*
+ * Receive-only N-PHY diagnostic.  The IQ estimator is the same hardware
+ * block used by b43_nphy_rx_iq_est(); reading this debugfs file starts one
+ * estimator run and snapshots receiver/RF state.  It does not request a
+ * scan, association, transmit frame, RF override, or calibration sequence.
+ */
+static ssize_t nphy_rxdiag_read_file(struct b43_wldev *dev,
+				     char *buf, size_t bufsize)
+{
+	struct b43_phy *phy = &dev->phy;
+	ssize_t count = 0;
+	u32 i0 = 0, q0 = 0, i1 = 0, q1 = 0;
+	s32 iq0 = 0, iq1 = 0;
+	u16 cmd;
+	int i;
+	bool complete = false;
+
+	if (phy->type != B43_PHYTYPE_N)
+		return -ENODEV;
+
+	fappend("status=%d\n", b43_status(dev));
+	fappend("phy_rev=%u\n", phy->rev);
+	fappend("radio_ver=0x%04x\n", phy->radio_ver);
+	fappend("radio_rev=%u\n", phy->radio_rev);
+	fappend("channel=%u\n", phy->channel);
+	fappend("radio_on=%u\n", phy->radio_on);
+	fappend("transfer=%s\n", b43_using_pio_transfers(dev) ? "pio" : "dma");
+	fappend("bbcfg=0x%04x\n", b43_phy_read(dev, B43_NPHY_BBCFG));
+	fappend("bandctl=0x%04x\n", b43_phy_read(dev, B43_NPHY_BANDCTL));
+	fappend("phy_channel_reg=0x%04x\n", b43_phy_read(dev, B43_NPHY_CHANNEL));
+	fappend("classctl=0x%04x\n", b43_phy_read(dev, B43_NPHY_CLASSCTL));
+	fappend("rfseqca=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFSEQCA));
+	fappend("rfseqmode=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFSEQMODE));
+	fappend("rfseqst=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFSEQST));
+	fappend("rfctl_cmd=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_CMD));
+	fappend("rfctl_over=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_OVER));
+	fappend("rfctl_intc1=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_INTC1));
+	fappend("rfctl_intc2=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_INTC2));
+	fappend("rfctl_rssio1=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO1));
+	fappend("rfctl_rssio2=0x%04x\n", b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO2));
+	fappend("afectl_c1=0x%04x\n", b43_phy_read(dev, B43_NPHY_AFECTL_C1));
+	fappend("afectl_c2=0x%04x\n", b43_phy_read(dev, B43_NPHY_AFECTL_C2));
+	fappend("afectl_over1=0x%04x\n", b43_phy_read(dev, B43_NPHY_AFECTL_OVER1));
+	fappend("afectl_over=0x%04x\n", b43_phy_read(dev, B43_NPHY_AFECTL_OVER));
+	fappend("c1_initgain=0x%04x\n", b43_phy_read(dev, B43_NPHY_C1_INITGAIN));
+	fappend("c2_initgain=0x%04x\n", b43_phy_read(dev, B43_NPHY_C2_INITGAIN));
+	fappend("c1_clip1=0x%04x\n", b43_phy_read(dev, B43_NPHY_C1_CLIP1THRES));
+	fappend("c2_clip1=0x%04x\n", b43_phy_read(dev, B43_NPHY_C2_CLIP1THRES));
+	if (phy->radio_ver == 0x2056) {
+		fappend("radio2056_syn_com_ctrl=0x%04x\n",
+			b43_radio_read(dev, B2056_SYN_COM_CTRL));
+		fappend("radio2056_syn_com_pu=0x%04x\n",
+			b43_radio_read(dev, B2056_SYN_COM_PU));
+		fappend("radio2056_rx0_com_pu=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_COM_PU));
+		fappend("radio2056_rx1_com_pu=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_COM_PU));
+		fappend("radio2056_rx0_lnaa_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_LNAA_MASTER));
+		fappend("radio2056_rx1_lnaa_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_LNAA_MASTER));
+		fappend("radio2056_rx0_lnag_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_LNAG_MASTER));
+		fappend("radio2056_rx1_lnag_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_LNAG_MASTER));
+		fappend("radio2056_rx0_mixg_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_MIXG_MASTER));
+		fappend("radio2056_rx1_mixg_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_MIXG_MASTER));
+		fappend("radio2056_rx0_tia_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_TIA_MASTER));
+		fappend("radio2056_rx1_tia_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_TIA_MASTER));
+		fappend("radio2056_rx0_lpf_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX0 | B2056_RX_BB_LPF_MASTER));
+		fappend("radio2056_rx1_lpf_master=0x%04x\n",
+			b43_radio_read(dev, B2056_RX1 | B2056_RX_BB_LPF_MASTER));
+	}
+
+	if (b43_status(dev) != B43_STAT_STARTED) {
+		fappend("iq_estimator=not-started\n");
+		return count;
+	}
+
+	/* Mirror b43_nphy_rx_iq_est() without altering RF/FEM overrides. */
+	b43_phy_write(dev, B43_NPHY_IQEST_SAMCNT, 4096);
+	b43_phy_maskset(dev, B43_NPHY_IQEST_WT,
+			~B43_NPHY_IQEST_WT_VAL, 32);
+	b43_phy_mask(dev, B43_NPHY_IQEST_CMD, ~B43_NPHY_IQEST_CMD_MODE);
+	b43_phy_set(dev, B43_NPHY_IQEST_CMD, B43_NPHY_IQEST_CMD_START);
+	for (i = 1000; i; i--) {
+		cmd = b43_phy_read(dev, B43_NPHY_IQEST_CMD);
+		if (!(cmd & B43_NPHY_IQEST_CMD_START)) {
+			i0 = (b43_phy_read(dev, B43_NPHY_IQEST_IPACC_HI0) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_IPACC_LO0);
+			q0 = (b43_phy_read(dev, B43_NPHY_IQEST_QPACC_HI0) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_QPACC_LO0);
+			iq0 = (b43_phy_read(dev, B43_NPHY_IQEST_IQACC_HI0) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_IQACC_LO0);
+			i1 = (b43_phy_read(dev, B43_NPHY_IQEST_IPACC_HI1) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_IPACC_LO1);
+			q1 = (b43_phy_read(dev, B43_NPHY_IQEST_QPACC_HI1) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_QPACC_LO1);
+			iq1 = (b43_phy_read(dev, B43_NPHY_IQEST_IQACC_HI1) << 16) |
+				b43_phy_read(dev, B43_NPHY_IQEST_IQACC_LO1);
+			complete = true;
+			break;
+		}
+		udelay(10);
+	}
+	fappend("iq_estimator_complete=%u\n", complete);
+	fappend("iq_samples=4096\n");
+	fappend("iq_i0_pwr=%u\n", i0);
+	fappend("iq_q0_pwr=%u\n", q0);
+	fappend("iq_iq0_prod=%d\n", iq0);
+	fappend("iq_i1_pwr=%u\n", i1);
+	fappend("iq_q1_pwr=%u\n", q1);
+	fappend("iq_iq1_prod=%d\n", iq1);
+	fappend("iq_core0_avg=%llu\n",
+		(unsigned long long)(((u64)i0 + q0) / 4096));
+	fappend("iq_core1_avg=%llu\n",
+		(unsigned long long)(((u64)i1 + q1) / 4096));
+	fappend("rx_iq_cal_rev3plus_implemented=0\n");
+
+	return count;
+}
+
+/*
+ * Software-only N-PHY calibration state.  This deliberately performs no
+ * PHY/radio/MMIO reads and does not start an estimator or calibration.  It
+ * is separate from nphy_rxdiag so a bad/new hardware register read can never
+ * hide the software cache/chanspec evidence behind one all-or-nothing read.
+ */
+static ssize_t nphy_calstate_read_file(struct b43_wldev *dev,
+                                      char *buf, size_t bufsize)
+{
+       struct b43_phy *phy = &dev->phy;
+       struct b43_phy_n *nphy;
+       ssize_t count = 0;
+
+       if (phy->type != B43_PHYTYPE_N)
+               return -ENODEV;
+       nphy = phy->n;
+       if (!nphy)
+               return -ENODEV;
+
+       fappend("calstate_source=software-only\n");
+       fappend("status=%d\n", b43_status(dev));
+       fappend("phy_rev=%u\n", phy->rev);
+       fappend("channel=%u\n", phy->channel);
+       fappend("rx_iq_cal_rev3plus_implemented=%u\n", phy->rev >= 3 ? 0 : 1);
+       fappend("rx_iq_cache_2g_a0=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_2G.a0);
+       fappend("rx_iq_cache_2g_a0_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_2G.a0);
+       fappend("rx_iq_cache_2g_b0=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_2G.b0);
+       fappend("rx_iq_cache_2g_b0_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_2G.b0);
+       fappend("rx_iq_cache_2g_a1=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_2G.a1);
+       fappend("rx_iq_cache_2g_a1_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_2G.a1);
+       fappend("rx_iq_cache_2g_b1=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_2G.b1);
+       fappend("rx_iq_cache_2g_b1_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_2G.b1);
+       fappend("rx_iq_cache_5g_a0=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_5G.a0);
+       fappend("rx_iq_cache_5g_a0_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_5G.a0);
+       fappend("rx_iq_cache_5g_b0=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_5G.b0);
+       fappend("rx_iq_cache_5g_b0_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_5G.b0);
+       fappend("rx_iq_cache_5g_a1=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_5G.a1);
+       fappend("rx_iq_cache_5g_a1_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_5G.a1);
+       fappend("rx_iq_cache_5g_b1=0x%04x\n", (u16)nphy->cal_cache.rxcal_coeffs_5G.b1);
+       fappend("rx_iq_cache_5g_b1_signed=%d\n", (int)nphy->cal_cache.rxcal_coeffs_5G.b1);
+       fappend("iqcal_2g_center_freq=%u\n", (unsigned int)nphy->iqcal_chanspec_2G.center_freq);
+       fappend("iqcal_2g_channel_type=%u\n", (unsigned int)nphy->iqcal_chanspec_2G.channel_type);
+       fappend("rssical_2g_center_freq=%u\n", (unsigned int)nphy->rssical_chanspec_2G.center_freq);
+       fappend("rssical_2g_channel_type=%u\n", (unsigned int)nphy->rssical_chanspec_2G.channel_type);
+       fappend("iqcal_5g_center_freq=%u\n", (unsigned int)nphy->iqcal_chanspec_5G.center_freq);
+       fappend("iqcal_5g_channel_type=%u\n", (unsigned int)nphy->iqcal_chanspec_5G.channel_type);
+       fappend("rssical_5g_center_freq=%u\n", (unsigned int)nphy->rssical_chanspec_5G.center_freq);
+       fappend("rssical_5g_channel_type=%u\n", (unsigned int)nphy->rssical_chanspec_5G.channel_type);
+       fappend("nphy_measure_hold=0x%02x\n", (unsigned int)nphy->measure_hold);
+       fappend("nphy_mute=%u\n", (unsigned int)nphy->mute);
+       fappend("nphy_perical=%u\n", (unsigned int)nphy->perical);
+       fappend("nphy_phyrxchain=0x%02x\n", (unsigned int)nphy->phyrxchain);
+       fappend("nphy_hw_phyrxchain=0x%02x\n", (unsigned int)nphy->hw_phyrxchain);
+       fappend("nphy_hw_phytxchain=0x%02x\n", (unsigned int)nphy->hw_phytxchain);
+       fappend("nphy_rxcalparams=0x%08x\n", nphy->rxcalparams);
+       fappend("nphy_hang_avoid=%u\n", (unsigned int)nphy->hang_avoid);
+       fappend("nphy_gain_boost=%u\n", (unsigned int)nphy->gain_boost);
+       fappend("nphy_elna_gain_config=%u\n", (unsigned int)nphy->elna_gain_config);
+       fappend("nphy_ipa2g_on=%u\n", (unsigned int)nphy->ipa2g_on);
+       fappend("nphy_ipa5g_on=%u\n", (unsigned int)nphy->ipa5g_on);
+       fappend("nphy_txpwrctrl=%u\n", (unsigned int)nphy->txpwrctrl);
+       fappend("nphy_txrx_chain=%u\n", (unsigned int)nphy->txrx_chain);
+       fappend("nphy_deaf_count=%u\n", nphy->deaf_count);
+       fappend("nphy_txiqlocal_coeffsvalid=%u\n", (unsigned int)nphy->txiqlocal_coeffsvalid);
+
+       return count;
+}
+
+static void rxiq_diag_store_comp(s16 dst[4],
+                                const struct b43_phy_n_iq_comp *src)
+{
+       dst[0] = src->a0;
+       dst[1] = src->b0;
+       dst[2] = src->a1;
+       dst[3] = src->b1;
+}
+
+static void rxiq_diag_load_comp(struct b43_phy_n_iq_comp *dst,
+                               const s16 src[4])
+{
+       dst->a0 = src[0];
+       dst->b0 = src[1];
+       dst->a1 = src[2];
+       dst->b1 = src[3];
+}
+
+/*
+ * Runtime PHY/radio calibration is only allowed with the MAC fully
+ * suspended. The generic debugfs wrapper serializes us with wl->mutex, but
+ * it deliberately does not suspend the MAC. Keep suspend nesting at exactly
+ * 0 -> 1 -> 0 and fail closed unless firmware acknowledges suspension and
+ * the MAC re-enables afterward.
+ */
+static int rxiq_diag_mac_suspend(struct b43_wldev *dev)
+{
+       u32 macctl, irq_reason;
+
+       if (dev->mac_suspended != 0)
+               return -EBUSY;
+       if (!(b43_read32(dev, B43_MMIO_MACCTL) & B43_MACCTL_ENABLED))
+               return -EIO;
+
+       b43_mac_suspend(dev);
+       macctl = b43_read32(dev, B43_MMIO_MACCTL);
+       irq_reason = b43_read32(dev, B43_MMIO_GEN_IRQ_REASON);
+       if (dev->mac_suspended == 1 &&
+           !(macctl & B43_MACCTL_ENABLED) &&
+           (irq_reason & B43_IRQ_MAC_SUSPENDED))
+               return 0;
+
+       /* b43_mac_suspend() increments the nesting count even on timeout. */
+       if (dev->mac_suspended == 1)
+               b43_mac_enable(dev);
+       return -ETIMEDOUT;
+}
+
+static bool rxiq_diag_mac_resume(struct b43_wldev *dev)
+{
+       if (dev->mac_suspended != 1)
+               return false;
+
+       b43_mac_enable(dev);
+       return dev->mac_suspended == 0 &&
+              (b43_read32(dev, B43_MMIO_MACCTL) & B43_MACCTL_ENABLED);
+}
+
+static ssize_t nphy_rxiq_cal_read_file(struct b43_wldev *dev,
+                                      char *buf, size_t bufsize)
+{
+       struct b43_dfsentry *e = dev->dfsentry;
+       struct b43_phy_n_iq_comp live;
+       ssize_t count = 0;
+
+       if (dev->phy.type != B43_PHYTYPE_N)
+               return -ENODEV;
+       b43_nphy_rxiq_read_diag(dev, &live);
+
+       fappend("diag=rv220w-rev4-bcm2056-rxiq\n");
+       fappend("stock_rxiq_dispatch=rev3plus-helper-0x11d370\n");
+       fappend("legacy_revlt3_reconstruction_retired=1\n");
+       fappend("rev4_active_calibration_blocked=1\n");
+       fappend("stock_rxcalparams=0x010100b5\n");
