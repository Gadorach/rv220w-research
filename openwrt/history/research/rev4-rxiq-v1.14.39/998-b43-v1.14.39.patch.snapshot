+			ieee80211_free_hw(hw);
+			return ERR_PTR(-EINVAL);
+		}
+		SET_IEEE80211_PERM_ADDR(hw, override_addr);
+		b43info(NULL, "Using module-supplied permanent MAC address %pM\\n",
+			override_addr);
+	} else if (b43_modparam_macaddr_mtd[0]) {
+		mtd = get_mtd_device_nm(b43_modparam_macaddr_mtd);
+		if (IS_ERR(mtd)) {
+			mtd_err = PTR_ERR(mtd);
+			b43err(NULL, "Unable to open MAC MTD source '%s': %d\\n",
+			       b43_modparam_macaddr_mtd, mtd_err);
+			ieee80211_free_hw(hw);
+			return ERR_PTR(mtd_err);
+		}
+		mtd_retlen = 0;
+		mtd_err = mtd_read(mtd, b43_modparam_macaddr_mtd_offset,
+				   ETH_ALEN, &mtd_retlen, mtd_addr);
+		put_mtd_device(mtd);
+		if (mtd_err || mtd_retlen != ETH_ALEN) {
+			b43err(NULL,
+			       "Unable to read MAC MTD source '%s' at 0x%lx: err=%d len=%zu\\n",
+			       b43_modparam_macaddr_mtd,
+			       b43_modparam_macaddr_mtd_offset, mtd_err, mtd_retlen);
+			ieee80211_free_hw(hw);
+			return ERR_PTR(mtd_err ? mtd_err : -EIO);
+		}
+		if (!is_valid_ether_addr(mtd_addr)) {
+			b43err(NULL, "Invalid base MAC %pM from MTD source '%s'\\n",
+			       mtd_addr, b43_modparam_macaddr_mtd);
+			ieee80211_free_hw(hw);
+			return ERR_PTR(-EINVAL);
+		}
+
+		carry = b43_modparam_macaddr_increment;
+		for (i = ETH_ALEN; i-- > 0 && carry; ) {
+			unsigned int sum = mtd_addr[i] + (carry & 0xff);
+
+			mtd_addr[i] = sum & 0xff;
+			carry = (carry >> 8) + (sum >> 8);
+		}
+		if (carry || !is_valid_ether_addr(mtd_addr)) {
+			b43err(NULL, "Invalid/overflowed MTD-derived MAC address %pM\\n",
+			       mtd_addr);
+			ieee80211_free_hw(hw);
+			return ERR_PTR(-ERANGE);
+		}
+		SET_IEEE80211_PERM_ADDR(hw, mtd_addr);
+		b43info(NULL,
+			"Using MTD-derived permanent MAC address %pM (source=%s offset=0x%lx increment=%u)\\n",
+			mtd_addr, b43_modparam_macaddr_mtd,
+			b43_modparam_macaddr_mtd_offset,
+			b43_modparam_macaddr_increment);
+	} else if (is_valid_ether_addr(sprom->et1mac)) {
 		SET_IEEE80211_PERM_ADDR(hw, sprom->et1mac);
-	else
+	} else {
 		SET_IEEE80211_PERM_ADDR(hw, sprom->il0mac);
+	}
 
 	/* Initialize struct b43_wl */
