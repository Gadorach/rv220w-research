+       fappend("active=%u\n", e->rxiq_diag_active);
+       fappend("last_rc=%d\n", e->rxiq_diag_last_rc);
+       fappend("cleanup_complete=%u\n", e->rxiq_diag_cleanup_complete);
+       fappend("restore_verified=%u\n", e->rxiq_diag_restore_verified);
+       fappend("run_mac_suspend_verified=%u\n",
+               e->rxiq_diag_run_mac_suspend_verified);
+       fappend("run_mac_resume_verified=%u\n",
+               e->rxiq_diag_run_mac_resume_verified);
+       fappend("restore_mac_suspend_verified=%u\n",
+               e->rxiq_diag_restore_mac_suspend_verified);
+       fappend("restore_mac_resume_verified=%u\n",
+               e->rxiq_diag_restore_mac_resume_verified);
+       fappend("cleanup_fail_mask=0x%08x\n", e->rxiq_diag_cleanup_fail_mask);
+       fappend("primary_rc=%d\n", e->rxiq_diag_primary_rc);
+       fappend("failure_stage=%u\n", e->rxiq_diag_failure_stage);
