+       fappend("radio_spare_saved1=0x%04x\n", e->rxiq_diag_radio_spare_saved[1]);
+       fappend("radio_spare_observed0=0x%04x\n", e->rxiq_diag_radio_spare_observed[0]);
+       fappend("radio_spare_observed1=0x%04x\n", e->rxiq_diag_radio_spare_observed[1]);
+       fappend("deaf_before=%u\n", e->rxiq_diag_deaf_before);
+       fappend("deaf_after=%u\n", e->rxiq_diag_deaf_after);
+       fappend("radio_spare_low2_observed0=0x%x\n",
+               e->rxiq_diag_radio_spare_observed[0] & 0x3);
+       fappend("radio_spare_low2_observed1=0x%x\n",
+               e->rxiq_diag_radio_spare_observed[1] & 0x3);
+       fappend("core0_pass0_i_pwr=%u\n", e->rxiq_diag_pass_i_pwr[0][0]);
