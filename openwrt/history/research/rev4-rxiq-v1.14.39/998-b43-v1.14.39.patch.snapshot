+       fappend("core1_pass2_q_pwr=%u\n", e->rxiq_diag_pass_q_pwr[1][2]);
+       fappend("core1_pass2_iq_prod=%d\n", e->rxiq_diag_pass_iq_prod[1][2]);
+       fappend("core1_pass2_power=%u\n", e->rxiq_diag_pass_power[1][2]);
+       fappend("core0_pass0_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[0][0]);
+       fappend("core0_pass1_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[0][1]);
+       fappend("core0_pass2_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[0][2]);
+       fappend("core0_pass3_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[0][3]);
+       fappend("core1_pass0_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[1][0]);
+       fappend("core1_pass1_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[1][1]);
+       fappend("core1_pass2_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[1][2]);
+       fappend("core1_pass3_packed_gain=0x%04x\n", e->rxiq_diag_pass_packed_gain[1][3]);
+       fappend("core0_final_i_pwr=%u\n", e->rxiq_diag_final_i_pwr[0]);
+       fappend("core0_final_q_pwr=%u\n", e->rxiq_diag_final_q_pwr[0]);
+       fappend("core0_final_iq_prod=%d\n", e->rxiq_diag_final_iq_prod[0]);
+       fappend("core1_final_i_pwr=%u\n", e->rxiq_diag_final_i_pwr[1]);
+       fappend("core1_final_q_pwr=%u\n", e->rxiq_diag_final_q_pwr[1]);
+       fappend("core1_final_iq_prod=%d\n", e->rxiq_diag_final_iq_prod[1]);
+       fappend("core0_calc_error=%u\n", e->rxiq_diag_calc_error[0]);
+       fappend("core1_calc_error=%u\n", e->rxiq_diag_calc_error[1]);
+       fappend("calc_applied_mask=0x%02x\n", e->rxiq_diag_calc_applied_mask);
+       fappend("saved_a0=%d\n", e->rxiq_diag_saved[0]);
+       fappend("saved_b0=%d\n", e->rxiq_diag_saved[1]);
+       fappend("saved_a1=%d\n", e->rxiq_diag_saved[2]);
