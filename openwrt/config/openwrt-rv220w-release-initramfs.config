CONFIG_TARGET_octeon=y
CONFIG_TARGET_octeon_generic=y
CONFIG_TARGET_octeon_generic_DEVICE_cisco_rv220w_persistent_writer=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=16
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y

# v1.16.0 installer/recovery initramfs. Keep this deliberately LAN-only and
# small: it exists to boot from RAM, verify the board/NOR geometry and launch
# the release sysupgrade over a directly connected LAN port. Production LuCI,
# b43/Wi-Fi and package-management functionality belongs in the persistent
# sysupgrade image, not in the RAM installer.
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_kmod-dsa-b53=y
CONFIG_PACKAGE_kmod-dsa-b53-mdio=y
# CONFIG_PACKAGE_tcpdump-mini is not set
# CONFIG_PACKAGE_kmod-mdio-netlink is not set
# CONFIG_PACKAGE_mdio-tools is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-octeon is not set

# Installer networking is direct-LAN only. These production-facing services
# are intentionally absent to preserve RAM for image validation/stage2.
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-light is not set
# CONFIG_PACKAGE_luci-base is not set
# CONFIG_PACKAGE_luci-mod-admin-full is not set
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_uhttpd is not set
# CONFIG_PACKAGE_uhttpd-mod-ubus is not set
# CONFIG_PACKAGE_rpcd-mod-luci is not set
# CONFIG_PACKAGE_rpcd-mod-rrdns is not set
# CONFIG_PACKAGE_kmod-b43 is not set
# CONFIG_PACKAGE_kmod-ssb is not set
# CONFIG_PACKAGE_B43_DEBUG is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_kmod-ledtrig-network is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpa-cli is not set
# CONFIG_PACKAGE_wpa-supplicant is not set
# CONFIG_PACKAGE_kmod-octeon-pci-irq-diag is not set
# CONFIG_PACKAGE_kmod-ssb-nvmem-diag is not set

CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"
