# Copy to config/toolkit.env.fish and edit as needed.
set -gx RV220W_BOX rv220w-openwrt
set -gx RV220W_BOX_IMAGE docker.io/library/ubuntu:24.04
set -gx RV220W_WORKSPACE "$HOME/src/rv220w-openwrt"
set -gx RV220W_OPENWRT_REF v25.12.5
set -gx RV220W_OPENWRT_URL https://github.com/openwrt/openwrt.git
set -gx RV220W_LINUX_REF linux-6.12.y
set -gx RV220W_LINUX_URL https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
set -gx RV220W_LINUX_CROSS_COMPILE mips64-linux-gnuabi64-
set -gx RV220W_MERAKI_BUILDER_REF ms42p-dev
set -gx RV220W_MERAKI_BUILDER_URL https://github.com/Gadorach/meraki-builder.git
set -gx RV220W_UART_BAUD 460800
set -gx RV220W_TFTP_LOADADDR 0x05500000
set -gx RV220W_TFTP_TEST_SUBNET 192.168.240.0/24

# Proven direct-link RAM-boot defaults for this RV220W test bench.
set -gx RV220W_TFTP_INTERFACE enp0s31f6
set -gx RV220W_TFTP_SERVER_IP 192.168.240.1
set -gx RV220W_TFTP_DEVICE_IP 192.168.240.2
set -gx RV220W_TFTP_ETHACT octeth0
set -gx RV220W_TFTP_CONFIGURE_INTERFACE 1
