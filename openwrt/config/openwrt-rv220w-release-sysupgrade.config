CONFIG_TARGET_octeon=y
CONFIG_TARGET_octeon_generic=y
CONFIG_TARGET_octeon_generic_DEVICE_cisco_rv220w_persistent=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=16
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
# JFFS2 and OverlayFS are built into OpenWrt v25.12.5 generic kernel config.
# There are no CONFIG_PACKAGE_kmod-fs-jffs2 or kmod-fs-overlayfs symbols.
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool-full=y
# CONFIG_PACKAGE_tcpdump-mini is not set
CONFIG_PACKAGE_kmod-dsa-b53=y
CONFIG_PACKAGE_kmod-dsa-b53-mdio=y
# CONFIG_PACKAGE_kmod-mdio-netlink is not set
# CONFIG_PACKAGE_mdio-tools is not set
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
# CONFIG_PACKAGE_kmod-usb-dwc3-octeon is not set
# CONFIG_PACKAGE_luci is not set
CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# v1.16.0 release profile. Keep the hardware-qualified b43/N-PHY surface,
# use native DMA, disable b43 debug instrumentation, and bake standard
# AP+STA/LuCI/package-management functionality into immutable SquashFS.
CONFIG_PACKAGE_kmod-b43=y
CONFIG_PACKAGE_kmod-ssb=y
CONFIG_PACKAGE_B43_BUSES_SSB=y
# CONFIG_PACKAGE_B43_BUSES_BCMA_AND_SSB is not set
# CONFIG_PACKAGE_B43_BUSES_BCMA is not set
CONFIG_PACKAGE_B43_PHY_N=y
# CONFIG_PACKAGE_B43_PHY_G is not set
# CONFIG_PACKAGE_B43_PHY_LP is not set
# CONFIG_PACKAGE_B43_PHY_HT is not set
# CONFIG_PACKAGE_B43_DEBUG is not set
CONFIG_PACKAGE_B43_PIO=y
CONFIG_B43_FW_5_100_138=y
# CONFIG_B43_FW_SQUASH is not set
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# LED trigger support is retained for the mainboard GPIO LED userspace policy.
CONFIG_PACKAGE_kmod-ledtrig-network=y
# CONFIG_PACKAGE_wpa-supplicant is not set
CONFIG_PACKAGE_wpad=y
# CONFIG_PACKAGE_kmod-octeon-pci-irq-diag is not set
# CONFIG_PACKAGE_kmod-ssb-nvmem-diag is not set
